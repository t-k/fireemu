  {
    "id": "nx01",
    "conditionId": "SCHEDULED-FUNCTIONS/next-occurrence",
    "case": "strictly-after-anchor",
    "schedule": "*/5 * * * *",
    "timeZone": "UTC",
    "timing": {
      "kind": "after-run",
      "everyMinutes": 5,
      "afterMs": 500
    },
    "note": "created half a second after a run instant: the next run is five minutes later, not now"
  },
  {
    "id": "nx02",
    "conditionId": "SCHEDULED-FUNCTIONS/next-occurrence",
    "case": "minute-boundary",
    "schedule": "* * * * *",
    "timeZone": "UTC",
    "timing": {
      "kind": "before-minute-boundary",
      "leadMs": 1500
    },
    "mustHave": "create-just-before-a-minute-boundary",
    "note": "dispatch about 1.5 s before a minute so the request window straddles it (as v5 c01)"
  },
