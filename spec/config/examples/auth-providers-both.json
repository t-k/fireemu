{
  "schemaVersion": 1,
  "profile": "strict",
  "limits": {
    "catalog": "firestore-standard-2026-08-25",
    "queryCatalog": "firestore-standard-query-2026-08-25",
    "rulesCatalog": "firebase-rules-2026-08-25"
  },
  "firestore": {
    "edition": "standard",
    "apiMode": "native"
  },
  "rules": {
    "executionMode": "admin-bypass"
  },
  "auth": {
    "providers": {
      "oidc": [
        {
          "name": "oidc.fixture",
          "enabled": true,
          "clientId": "local-client",
          "issuer": "https://issuer.test"
        }
      ],
      "saml": [
        {
          "name": "saml.fixture",
          "enabled": true,
          "idpConfig": {
            "idpEntityId": "idp",
            "ssoUrl": "https://sso.test",
            "idpCertificates": [
              {
                "x509Certificate": "PUBLIC-TEST-CERTIFICATE"
              }
            ]
          },
          "spConfig": {
            "spEntityId": "sp",
            "callbackUri": "https://callback.test"
          }
        }
      ]
    }
  }
}
