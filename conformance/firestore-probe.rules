// The ruleset the Firestore semantics probe runs under on both sides: every request is
// admitted, so the recorded answers are the query, write, transaction and error semantics
// of the runtime and nothing else. Rules parity has its own probe (`rules-probe/`).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
