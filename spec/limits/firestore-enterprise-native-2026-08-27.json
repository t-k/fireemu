  "conformanceRevision": "unverified",
  "limits": [
    {
      "id": "FS-ENT-LIMIT-QUERY-MEMORY",
      "class": "hard-resource",
      "boundary": "inclusive-maximum",
      "unit": "bytes",
      "maximum": 134217728,
      "precision": "conservative",
      "enforcementStage": "query-plan",
      "implemented": "unsupported",
      "officialText": "Maximum memory a query can use: 128 MiB",
      "notes": "Plan-time upper bound plus a runtime exact counter."
    },
    {
      "id": "FS-ENT-LIMIT-INDEXES",
      "class": "plan-capacity",
      "boundary": "inclusive-maximum",
      "unit": "count",
      "maximum": { "billingDisabled": 200, "billingEnabled": 1000 },
      "precision": "exact",
      "enforcementStage": "config-load",
      "implemented": "unsupported",
      "officialText": "Maximum number of indexes for a database: 200 (billing disabled), 1,000 (billing enabled); support may raise the limit",
      "notes": "Override via FirestorePlanProfile::enterprise_index_limit_override."
    },
    {
      "id": "FS-ENT-LIMIT-INDEX-ENTRIES-PER-DOCUMENT",
      "class": "hard-resource",
      "boundary": "inclusive-maximum",
      "unit": "count",
      "maximum": 40000,
      "precision": "exact",
      "enforcementStage": "commit",
      "implemented": "unsupported",
      "officialText": "Maximum number of index entries for each document: 40,000",
      "notes": "Exact for supported index encoders only."
    },
    {
      "id": "FS-ENT-LIMIT-FIELDS-PER-INDEX",
      "class": "hard-resource",
      "boundary": "inclusive-maximum",
      "unit": "count",
      "maximum": 100,
      "precision": "exact",
      "enforcementStage": "config-load",
      "implemented": "unsupported",
      "officialText": "Maximum number of fields in an index: 100",
      "notes": ""
    },
    {
      "id": "FS-ENT-LIMIT-INDEX-ENTRY-BYTES",
      "class": "hard-resource",
      "boundary": "inclusive-maximum",
      "unit": "bytes",
      "maximum": 7680,
      "precision": "boundary-conformance",
      "enforcementStage": "commit",
      "implemented": "unsupported",
      "officialText": "Maximum size of an index entry: 7.5 KiB",
      "notes": "Precision depends on the index type; text index entries are estimated only."
    },
    {
      "id": "FS-ENT-LIMIT-INDEX-ENTRY-SUM-PER-DOCUMENT",
      "class": "hard-resource",
      "boundary": "inclusive-maximum",
      "unit": "bytes",
