  },
  "steps": [
    {
      "id": "runQuery-needing-a-composite-index",
      "status": "documented-divergence",
      "oracle": {
        "body": [
          {
            "document": {
              "createTime": "<timestamp>",
              "fields": {
                "age": {
                  "integerValue": "1"
                },
                "city": {
                  "stringValue": "tokyo"
                },
                "name": {
                  "stringValue": "x"
                }
              },
              "name": "projects/demo-conformance/databases/(default)/documents/conf_index/one",
              "updateTime": "<timestamp>"
            },
            "done": true,
            "readTime": "<timestamp>"
          }
        ],
        "status": 200
      },
      "testd": {
        "body": [
          {
            "document": {
              "createTime": "<timestamp>",
              "fields": {
                "age": {
                  "integerValue": "1"
                },
                "city": {
                  "stringValue": "tokyo"
                },
                "name": {
                  "stringValue": "x"
                }
              },
              "name": "projects/demo-conformance/databases/(default)/documents/conf_index/one",
              "updateTime": "<timestamp>"
            },
            "readTime": "<timestamp>"
          }
        ],
        "status": 200
      },
      "documents": "README.md, \"Gap from the official Firebase Emulator Suite\"",
      "reason": "The official emulator ends a REST runQuery stream with `done: true` on the last response; production omits the field and fireemu follows production."
    },
    {
      "id": "runQuery-with-an-unknown-operator",
      "status": "debt",
      "oracle": {
        "body": {
          "error": {
            "code": 400,
            "message": "Payload isn't valid for request.",
            "status": "INVALID_ARGUMENT"
          }
        },
        "status": 400
      },
      "testd": {
        "body": [
          {
            "error": {
              "code": 400,
              "message": "unknown field filter operator",
              "status": "INVALID_ARGUMENT"
            }
          }
        ],
        "status": 400
      }
    },
    {
      "id": "get-a-missing-document",
      "status": "documented-divergence",
      "oracle": {
        "body": {
          "error": {
            "code": 404,
            "message": "Document (projects/demo-conformance/databases/(default)/documents/conf_values/definitely-missing) not found.",
            "status": "NOT_FOUND"
          }
        },
        "status": 404
      },
      "testd": {
        "body": {
          "error": {
            "code": 404,
            "message": "Document \"projects/demo-conformance/databases/(default)/documents/conf_values/definitely-missing\" not found.",
            "status": "NOT_FOUND"
          }
        },
        "status": 404
      },
      "documents": "conformance/FIRESTORE-PRODUCTION-MATRIX.md; README.md, \"Gap from the official Firebase Emulator Suite\"",
      "reason": "Production answers a missing document with `Document \"projects/.../documents/...\" not found.` (recorded 2026-09-07); the official emulator says `Document (projects/.../documents/...) not found.`. fireemu follows production (567565bdd)."
    }
  ]
