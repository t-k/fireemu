{
  "name": "fireemu-conformance",
  "private": true,
  "description": "Opt-in differential conformance suite: one scenario corpus run against the official Local Emulator Suite (the oracle) and against fireemu.",
  "type": "module",
  "scripts": {
    "oracle": "node src/oracle.mjs",
    "check": "node src/check.mjs",
    "matrix": "node src/rules-probe/run.mjs record",
    "matrix:check": "node src/rules-probe/run.mjs check",
    "programs": "node src/rules-probe/run.mjs record-programs",
    "programs:check": "node src/rules-probe/run.mjs check-programs",
    "firestore": "node src/firestore-probe/run.mjs record",
    "firestore:check": "node src/firestore-probe/run.mjs check",
    "storage-probe": "node src/storage-probe/run.mjs record",
    "storage-probe:check": "node src/storage-probe/run.mjs check",
    "pubsub-probe": "node src/pubsub-probe/run.mjs record",
    "pubsub-probe:check": "node src/pubsub-probe/run.mjs check",
    "corpus": "node src/list.mjs",
    "selftest": "node --test src/*.test.mjs",
    "lint": "oxlint src functions",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "firestore:production": "node src/firestore-probe/run.mjs record-production"
  },
  "dependencies": {
    "@google-cloud/pubsub": "4.11.0",
    "firebase": "12.18.0",
    "firebase-admin": "14.3.0",
    "firebase-functions": "7.3.2",
    "firebase-tools": "15.28.2",
    "neverthrow": "8.2.0"
  },
  "devDependencies": {
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0"
  }
}
