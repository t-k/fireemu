{
  "schemaVersion": 1,
  "model": "RulesetActivation",
  "mutations": [
    {
      "id": "M-FORMAL-RULES-CHECKS-001",
      "property": "ActivationRequiresAllChecks",
      "operator": "activate-before-limit-check",
      "from": "candidatePhase == \"Checked\",\n    record(\"Activate\"",
      "to": "candidatePhase == \"Compiled\",\n    record(\"Activate\""
    },
    {
      "id": "M-FORMAL-RULES-REJECTED-001",
      "property": "FailedCandidateNeverActivates",
      "operator": "activate-rejected-candidate",
      "from": "candidatePhase == \"Checked\",\n    record(\"Activate\"",
      "to": "candidatePhase == \"Rejected\",\n    record(\"Activate\""
    },
    {
      "id": "M-FORMAL-RULES-REQUEST-PIN-001",
      "property": "EvaluationSnapshotIsImmutable",
      "operator": "rebind-inflight-evaluation-to-active-version",
      "from": "record(\"ProgressEvaluation\", evaluation, observable)",
      "to": "record(\"ProgressEvaluation\", evaluation, { activeVersion: observable.activeVersion, generation: observable.generation, evaluationVersion: observable.evaluationVersion.set(evaluation, observable.activeVersion), evaluationGeneration: observable.evaluationGeneration })"
    },
    {
      "id": "M-FORMAL-RULES-REQUEST-GENERATION-001",
      "property": "EvaluationSnapshotIsImmutable",
      "operator": "rebind-inflight-evaluation-to-current-generation",
      "from": "record(\"ProgressEvaluation\", evaluation, observable)",
      "to": "record(\"ProgressEvaluation\", evaluation, { activeVersion: observable.activeVersion, generation: observable.generation, evaluationVersion: observable.evaluationVersion, evaluationGeneration: observable.evaluationGeneration.set(evaluation, observable.generation) })"
    },
    {
      "id": "M-FORMAL-RULES-ACTIVE-ATOMIC-001",
      "property": "ActiveVersionChangesAtomically",
      "operator": "publish-active-pointer-during-compile",
      "from": "record(\"Compile\", \"\", observable)",
      "to": "record(\"Compile\", \"\", { activeVersion: \"v2\", generation: observable.generation, evaluationVersion: observable.evaluationVersion, evaluationGeneration: observable.evaluationGeneration })"
    },
    {
      "id": "M-FORMAL-RULES-ATOMIC-001",
      "property": "AtomicRulesetActivation",
      "operator": "publish-generation-before-active-version",
      "from": "activeVersion: observable.activeVersion,\n      generation: observable.generation,\n      evaluationVersion: observable.evaluationVersion.set(evaluation, observable.activeVersion),\n      evaluationGeneration: observable.evaluationGeneration.set(evaluation, observable.generation)",
      "to": "activeVersion: observable.activeVersion,\n      generation: observable.generation + 1,\n      evaluationVersion: observable.evaluationVersion.set(evaluation, observable.activeVersion),\n      evaluationGeneration: observable.evaluationGeneration.set(evaluation, observable.generation)"
    },
    {
      "id": "M-FORMAL-RULES-CREATE-ORDER-001",
      "property": "AtomicRulesetActivation",
      "operator": "delete-create-phase-guard",
      "from": "candidatePhase == \"Absent\",\n    record(\"Create\"",
      "to": "record(\"Create\""
    },
    {
      "id": "M-FORMAL-RULES-PARSE-ORDER-001",
      "property": "AtomicRulesetActivation",
      "operator": "delete-parse-phase-guard",
      "from": "candidatePhase == \"Created\",\n    record(\"Parse\"",
      "to": "record(\"Parse\""
    },
    {
      "id": "M-FORMAL-RULES-COMPILE-ORDER-001",
      "property": "AtomicRulesetActivation",
      "operator": "delete-compile-phase-guard",
      "from": "candidatePhase == \"Parsed\",\n    record(\"Compile\"",
      "to": "record(\"Compile\""
    },
    {
      "id": "M-FORMAL-RULES-CHECK-ORDER-001",
      "property": "AtomicRulesetActivation",
      "operator": "delete-check-phase-guard",
      "from": "candidatePhase == \"Compiled\",\n    record(\"Check\"",
      "to": "record(\"Check\""
    },
    {
      "id": "M-FORMAL-RULES-REJECT-ORDER-001",
      "property": "AtomicRulesetActivation",
      "operator": "delete-reject-phase-guard",
      "from": "candidatePhase.in(Set(\"Created\", \"Parsed\", \"Compiled\", \"Checked\")),\n    record(\"Reject\"",
      "to": "record(\"Reject\""
    },
    {
      "id": "M-FORMAL-RULES-PROGRESS-ORDER-001",
      "property": "AtomicRulesetActivation",
      "operator": "delete-progress-state-guard",
      "from": "evaluationState.get(evaluation) == \"Running\",\n    record(\"ProgressEvaluation\"",
      "to": "record(\"ProgressEvaluation\""
    },
    {
      "id": "M-FORMAL-RULES-FINISH-ORDER-001",
      "property": "AtomicRulesetActivation",
      "operator": "delete-finish-state-guard",
      "from": "evaluationState.get(evaluation) == \"Running\",\n    record(\"FinishEvaluation\"",
      "to": "record(\"FinishEvaluation\""
    },
    {
      "id": "M-FORMAL-RULES-START-ORDER-001",
      "property": "AtomicRulesetActivation",
      "operator": "delete-start-state-guard",
      "from": "evaluationState.get(evaluation) == \"Idle\",\n    record(\"StartEvaluation\"",
      "to": "record(\"StartEvaluation\""
    },
    {
      "id": "M-FORMAL-RULES-CREATE-DESTINATION-001",
      "property": "AtomicRulesetActivation",
      "operator": "create-enters-wrong-phase",
      "from": "candidatePhase' = \"Created\"",
      "to": "candidatePhase' = \"Parsed\""
    },
    {
      "id": "M-FORMAL-RULES-PARSE-DESTINATION-001",
      "property": "AtomicRulesetActivation",
      "operator": "parse-enters-wrong-phase",
      "from": "candidatePhase' = \"Parsed\"",
      "to": "candidatePhase' = \"Compiled\""
    },
    {
      "id": "M-FORMAL-RULES-COMPILE-DESTINATION-001",
      "property": "AtomicRulesetActivation",
      "operator": "compile-enters-wrong-phase",
      "from": "candidatePhase' = \"Compiled\"",
      "to": "candidatePhase' = \"Checked\""
    },
    {
      "id": "M-FORMAL-RULES-CHECK-DESTINATION-001",
      "property": "AtomicRulesetActivation",
      "operator": "check-enters-wrong-phase",
      "from": "candidatePhase' = \"Checked\"",
      "to": "candidatePhase' = \"Active\""
    },
    {
      "id": "M-FORMAL-RULES-REJECT-DESTINATION-001",
      "property": "AtomicRulesetActivation",
      "operator": "reject-enters-wrong-phase",
      "from": "candidatePhase' = \"Rejected\"",
      "to": "candidatePhase' = \"Created\""
    },
    {
      "id": "M-FORMAL-RULES-START-DESTINATION-001",
      "property": "AtomicRulesetActivation",
      "operator": "start-finishes-evaluation",
      "from": "evaluationState' = evaluationState.set(evaluation, \"Running\")",
      "to": "evaluationState' = evaluationState.set(evaluation, \"Finished\")"
    },
    {
      "id": "M-FORMAL-RULES-PROGRESS-DESTINATION-001",
      "property": "AtomicRulesetActivation",
      "operator": "progress-finishes-evaluation",
      "from": "record(\"ProgressEvaluation\", evaluation, observable),\n    candidatePhase' = candidatePhase,\n    evaluationState' = evaluationState",
      "to": "record(\"ProgressEvaluation\", evaluation, observable),\n    candidatePhase' = candidatePhase,\n    evaluationState' = evaluationState.set(evaluation, \"Finished\")"
    },
    {
      "id": "M-FORMAL-RULES-FINISH-DESTINATION-001",
      "property": "AtomicRulesetActivation",
      "operator": "finish-leaves-evaluation-running",
      "from": "evaluationState' = evaluationState.set(evaluation, \"Finished\")",
      "to": "evaluationState' = evaluationState.set(evaluation, \"Running\")"
    }
  ]
}
