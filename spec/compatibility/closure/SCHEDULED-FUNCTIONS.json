  "scopeDecisions": [
    {
      "id": "S1",
      "decision": "Include Node.js v1 pubsub.schedule and v2 onSchedule, Cloud Scheduler dependencies and explicitly classified Fireemu-only scheduler/clock.",
      "rationale": "Matches the lane8 owner directive.",
      "status": "FROZEN",
      "decidedBy": "coordinator (delegated by owner)",
      "decidedOn": "2026-09-30",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-30 SCHEDULED-FUNCTIONS scope: coordinator rulings)"
    },
    {
      "id": "S2",
      "decision": "Exclude task queues and recommend TASK-QUEUE-FUNCTIONS as a separate future parent candidate without starting it.",
      "rationale": "Cloud Tasks queue admission, rate, concurrency, deduplication and retries are an independent service lifecycle.",
      "status": "FROZEN",
      "decidedBy": "coordinator (delegated by owner)",
      "decidedOn": "2026-09-30",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-30 SCHEDULED-FUNCTIONS scope: coordinator rulings)"
    },
    {
      "id": "S3",
      "decision": "Exclude generic Pub/Sub/custom Eventarc and ordinary Firebase source-event trigger parity.",
      "rationale": "Owned by lane7 and FUNCTIONS-EVENTS; schedule-specific delivery remains here.",
      "status": "FROZEN",
      "decidedBy": "coordinator (delegated by owner)",
      "decidedOn": "2026-09-30",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-30 SCHEDULED-FUNCTIONS scope: coordinator rulings)"
    },
    {
      "id": "S4",
      "decision": "Cloud Scheduler job readbacks are oracle setup/calendar evidence; no generic Cloud Scheduler management REST implementation claim.",
      "rationale": "Local scope is declaration, calendar evaluation and handler-visible behavior.",
      "status": "FROZEN",
      "decidedBy": "coordinator (delegated by owner)",
      "decidedOn": "2026-09-30",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-30 SCHEDULED-FUNCTIONS scope: coordinator rulings)"
    },
    {
      "id": "S5",
      "decision": "English-like App Engine/groc schedules are included; App Engine HTTP application targets, billing, scaling, IAM parity and arbitrary external targets are excluded.",
      "rationale": "Language support differs from deployment target support.",
      "status": "FROZEN",
      "decidedBy": "coordinator (delegated by owner)",
      "decidedOn": "2026-09-30",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-30 SCHEDULED-FUNCTIONS scope: coordinator rulings)"
    },
    {
      "id": "S6",
      "decision": "Observe one pinned Node.js fixture/SDK, both generations, one region; compare exact cases on final binary/runner.",
      "rationale": "Bounded reproducible observations do not prove all runtimes or regions.",
      "status": "FROZEN",
      "decidedBy": "coordinator (delegated by owner)",
      "decidedOn": "2026-09-30",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-30 SCHEDULED-FUNCTIONS scope: coordinator rulings)"
    },
    {
      "id": "S7",
      "decision": "Fireemu-only rows use local properties/regressions/mutation evidence, not fictitious production recordings.",
      "rationale": "Virtual clock, catch-up policies and rewind have no Google control API counterpart.",
      "status": "FROZEN",
      "decidedBy": "coordinator (delegated by owner)",
      "decidedOn": "2026-09-30",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-30 SCHEDULED-FUNCTIONS scope: coordinator rulings)"
    },
    {
      "id": "S8",
      "decision": "Retain and document fail-closed token verification after explicit backwards rewind; coordinate shared admission helper edits and limit lane8 fixes to schedule/manual paths.",
      "rationale": "Avoid weakening Auth verification and changing other lanes source semantics without review.",
      "status": "FROZEN",
      "decidedBy": "coordinator (delegated by owner)",
      "decidedOn": "2026-09-30",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-30 SCHEDULED-FUNCTIONS scope: coordinator rulings)"
    }
  ],
