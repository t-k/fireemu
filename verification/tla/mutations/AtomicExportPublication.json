{
  "schemaVersion": 1,
  "model": "AtomicExportPublication",
  "mutations": [
    {
      "id": "M-TLA-EXPORT-PARTIAL-001",
      "property": "NoPartialPublication",
      "operator": "publish-partial-stage",
      "from": "/\\ stage = \"Complete\"\n    /\\ targetIdentity = \"Original\"",
      "to": "/\\ stage = \"Partial\"\n    /\\ targetIdentity = \"Original\""
    },
    {
      "id": "M-TLA-EXPORT-SWAP-001",
      "property": "PublicationRequiresCompletePrivateStage",
      "operator": "publish-after-target-replacement",
      "from": "/\\ stage = \"Complete\"\n    /\\ targetIdentity = \"Original\"",
      "to": "/\\ stage = \"Complete\"\n    /\\ targetIdentity = \"Changed\""
    },
    {
      "id": "M-TLA-EXPORT-REFUSAL-001",
      "property": "RefusalPreservesPublicArtifact",
      "operator": "replace-public-artifact-on-refusal",
      "from": "/\\ stage' = \"Absent\"\n    /\\ stagePrivate' = FALSE\n    /\\ Record(\"Refuse\")\n    /\\ UNCHANGED <<targetIdentity, publicArtifact, publicPrivate>>",
      "to": "/\\ stage' = \"Absent\"\n    /\\ stagePrivate' = FALSE\n    /\\ publicArtifact' = \"New\"\n    /\\ Record(\"Refuse\")\n    /\\ UNCHANGED <<targetIdentity, publicPrivate>>"
    },
    {
      "id": "M-TLA-EXPORT-PRIVATE-001",
      "property": "PublishedArtifactIsPrivate",
      "operator": "publish-world-readable-artifact",
      "from": "/\\ publicArtifact' = \"New\"\n    /\\ publicPrivate' = stagePrivate",
      "to": "/\\ publicArtifact' = \"New\"\n    /\\ publicPrivate' = FALSE"
    },
    {
      "id": "M-TLA-EXPORT-ATOMIC-001",
      "property": "AtomicExportPublication",
      "operator": "publish-partial-stage-through-composite",
      "from": "/\\ stage = \"Complete\"\n    /\\ targetIdentity = \"Original\"",
      "to": "/\\ stage = \"Partial\"\n    /\\ targetIdentity = \"Original\""
    }
  ]
}
