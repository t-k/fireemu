rules_version = '2';

// The real @firebase/rules-unit-testing smoke loads this source dynamically through the
// Storage emulator's PUT /internal/setRules endpoint. A user owns only their own prefix.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{path=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
