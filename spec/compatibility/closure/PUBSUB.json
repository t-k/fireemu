  "oracleTrack": "disposable-sandbox",
  "oracle": {
    "project": "fireemu-oracle-idp",
    "region": "us-central1"
  },
  "closureReview": {
    "decision": "PENDING"
  },
  "scopeDecisions": [
    {
      "id": "P1",
      "decision": "Include unary REST v1 and native google.pubsub.v1 gRPC plus StreamingPull. Latency, throughput, fleet failover, scaling and billing behavior are outside this parent.",
      "rationale": "Both wire protocols and streaming are existing supported claims; bounded semantic observations are distinct from performance promises.",
      "status": "FROZEN",
      "decidedBy": "coordinator (delegated by owner)",
      "decidedOn": "2026-09-30",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-30 PUBSUB and EVENTARC scope: coordinator rulings)"
    },
    {
      "id": "P2",
      "decision": "Include retention configuration and retained-message replay. Multi-day wall-clock expiration and subscription idle expiration are outside the bounded production campaign.",
      "rationale": "Retention configuration is required even though the current emulator subset rejects it; logical-clock regressions cover changes to expiry scheduling.",
      "status": "FROZEN",
      "decidedBy": "coordinator (delegated by owner)",
      "decidedOn": "2026-09-30",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-30 PUBSUB and EVENTARC scope: coordinator rulings)"
    },
    {
      "id": "P3",
      "decision": "Include snapshots and seek. UpdateTopic, DetachSubscription, unsupported UpdateSnapshot mutations, schemas, transforms, BigQuery/Cloud Storage export delivery, exactly-once, cross-project resources and managed IAM administration are outside this parent.",
      "rationale": "Snapshots and seek are already claimed; managed features beyond the supported broker subset need separately declared scope.",
      "status": "FROZEN",
      "decidedBy": "coordinator (delegated by owner)",
      "decidedOn": "2026-09-30",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-30 PUBSUB and EVENTARC scope: coordinator rulings)"
    },
    {
      "id": "P4",
      "decision": "Include the push subscription configuration API: create with pushConfig, get, modifyPushConfig and refusal shapes. Push delivery is outside this parent. Never publish to a topic that has a push subscription during configuration observation.",
      "rationale": "Observe the API without causing a request to its endpoint; loopback-only local push remains a documented local boundary.",
      "status": "FROZEN",
      "decidedBy": "coordinator (delegated by owner)",
      "decidedOn": "2026-09-30",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-30 PUBSUB and EVENTARC scope: coordinator rulings)"
    },
    {
      "id": "P5",
      "decision": "Include missing/invalid-token authentication refusal. IAM permission refusal is outside this parent; do not create a restricted principal.",
      "rationale": "The coordinator explicitly excludes IAM permission refusal while keeping transport authentication errors observable.",
      "status": "FROZEN",
      "decidedBy": "coordinator (delegated by owner)",
      "decidedOn": "2026-09-30",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-30 PUBSUB and EVENTARC scope: coordinator rulings)"
    },
    {
      "id": "P6",
      "decision": "Pub/Sub-to-Functions delivery belongs to FUNCTIONS-EVENTS; custom Eventarc belongs to EVENTARC and scheduled functions belong to SCHEDULED-FUNCTIONS.",
      "rationale": "The parent observes the Pub/Sub broker API without duplicating other parent delivery obligations.",
      "status": "FROZEN",
      "decidedBy": "coordinator (delegated by owner)",
      "decidedOn": "2026-09-30",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-30 PUBSUB and EVENTARC scope: coordinator rulings)"
    }
  ],
