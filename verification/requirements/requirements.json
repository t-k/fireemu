{
  "schemaVersion": 1,
  "source": "spec sections 21.2, 21.3, 32",
  "requirements": [
    {
      "id": "INV-EPOCH-001",
      "statement": "Work from an old epoch never mutates the state of the current epoch.",
      "criticality": "critical",
      "owner": "core-session",
      "status": "implemented",
      "artifacts": {
        "tla": "SessionEpoch.tla::EpochIsolation",
        "loom": [
          "stale_epoch_never_mutates_new_state",
          "reset_races_with_commit"
        ],
        "kani": "epoch_guard_rejects_every_other_epoch",
        "property": "prop_epoch_guard_rejects_non_current",
        "mutation": [
          "M-EPOCH-001"
        ],
        "integration": [
          "crates/ftd-core-session/tests/session.rs",
          "crates/ftd-core-events/tests/outbox.rs"
        ]
      }
    },
    {
      "id": "INV-TIME-001",
      "statement": "Logical time never moves backwards during normal operation.",
      "criticality": "critical",
      "owner": "core-session",
      "status": "implemented",
      "artifacts": {
        "tla": "SessionEpoch.tla::EpochNeverDecreases",
        "kani": "virtual_clock_never_moves_backwards",
        "property": "prop_clock_advance_is_monotonic",
        "mutation": [
          "M-SCHED-001"
        ],
        "integration": [
          "crates/ftd-core-session/tests/clock.rs"
        ]
      }
    },
    {
      "id": "INV-EVENT-001",
      "statement": "A terminal event never returns to a non-terminal state.",
      "criticality": "critical",
      "owner": "core-events",
      "status": "implemented",
      "artifacts": {
        "tla": "EventDelivery.tla::NoTerminalRegression",
        "loom": [
          "event_success_races_with_retry_timer"
        ],
        "kani": "terminal_event_rejects_every_transition",
        "property": "prop_terminal_states_are_absorbing",
        "mutation": [
          "M-RETRY-001",
          "M-RETRY-002"
        ],
        "integration": [
          "crates/ftd-core-events/tests/state_machine.rs"
        ]
      },
      "note": "terminal_event_rejects_every_transition builds a real event, so it allocates: on macOS with Kani 0.67 it hits the known 'malloc with missing definition' limitation recorded in the README and only verifies where the allocator is modelled."
    },
    {
      "id": "INV-IDLE-001",
      "statement": "await-idle must not return while causal work (including child enqueue reservations and Text Index backfill) is active.",
      "criticality": "critical",
      "owner": "core-session",
      "status": "implemented",
      "artifacts": {
        "tla": "AwaitIdle.tla::NoFalseIdle",
        "loom": [
          "await_idle_races_with_child_enqueue",
          "active_work_counter_never_underflows",
          "await_idle_races_with_text_index_backfill_completion"
        ],
        "kani": "idle_predicate_never_ignores_active_work",
        "property": "prop_idle_implies_all_terminal",
        "mutation": [
          "M-IDLE-001",
          "M-IDLE-002",
          "M-IDLE-003"
        ],
        "integration": [
          "crates/ftd-core-session/tests/idle.rs"
        ]
      }
    },
    {
      "id": "LIVE-RESET-001",
      "statement": "After a reset begins, the new epoch eventually becomes Active.",
      "criticality": "critical",
      "owner": "core-session",
      "status": "implemented",
      "artifacts": {
        "tla": "SessionEpoch.tla::ResetEventuallyActivatesNewEpoch",
        "mutation": [
          "M-EPOCH-001"
        ],
        "integration": [
          "crates/ftd-core-session/tests/session.rs"
        ]
      }
    },
    {
      "id": "LIVE-DISPATCH-001",
      "statement": "Under finite retries and fair workers, every event reaches success, dead-letter or cancellation.",
      "criticality": "critical",
      "owner": "core-events",
      "status": "implemented",
      "artifacts": {
        "tla": "EventDelivery.tla::EventEventuallyTerminates",
        "mutation": [
          "M-RETRY-001",
          "M-RETRY-002"
        ],
        "integration": [
          "crates/ftd-core-events/tests/state_machine.rs"
        ]
      }
    },
    {
      "id": "LIVE-IDLE-001",
      "statement": "When external input stops and work is finite, await-idle eventually returns.",
      "criticality": "critical",
      "owner": "core-session",
      "status": "implemented",
      "artifacts": {
        "tla": "AwaitIdle.tla::AwaitIdleEventuallyReturns",
