{
  "name": "fireemu-conformance",
  "private": true,
  "description": "Opt-in differential conformance suite: one scenario corpus run against the official Local Emulator Suite (the oracle) and against fireemu.",
  "type": "module",
  "scripts": {
    "oracle": "node src/oracle.mjs",
    "check": "node src/check.mjs",
    "corpus": "node src/list.mjs",
    "selftest": "node --test src/diff.test.mjs",
    "lint": "oxlint src functions",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check ."
  },
  "dependencies": {
    "firebase": "12.18.0",
    "firebase-admin": "14.3.0",
    "firebase-functions": "7.3.2",
    "firebase-tools": "15.28.2",
    "neverthrow": "8.2.0"
  },
  "devDependencies": {
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0"
  }
}
