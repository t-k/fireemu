{
  "schemaVersion": 1,
  "model": "RulesetActivation",
  "mutations": [
    {
      "id": "M-TLA-RULES-CHECKS-001",
      "property": "ActivationRequiresAllChecks",
      "operator": "activate-before-limit-check",
      "from": "/\\ candidatePhase = \"Checked\"\n    /\\ candidatePhase' = \"Active\"",
      "to": "/\\ candidatePhase = \"Compiled\"\n    /\\ candidatePhase' = \"Active\""
    },
    {
      "id": "M-TLA-RULES-REJECTED-001",
      "property": "FailedCandidateNeverActivates",
      "operator": "activate-rejected-candidate",
      "from": "/\\ candidatePhase = \"Checked\"\n    /\\ candidatePhase' = \"Active\"",
      "to": "/\\ candidatePhase = \"Rejected\"\n    /\\ candidatePhase' = \"Active\""
    },
    {
      "id": "M-TLA-RULES-REQUEST-PIN-001",
      "property": "RequestVersionIsImmutable",
      "operator": "rebind-inflight-request-to-active-version",
      "from": "/\\ Record(\"ProgressRequest\", {r})\n    /\\ UNCHANGED <<candidatePhase, activeVersion, requestState, requestVersion>>",
      "to": "/\\ requestVersion' = [requestVersion EXCEPT ![r] = activeVersion]\n    /\\ Record(\"ProgressRequest\", {r})\n    /\\ UNCHANGED <<candidatePhase, activeVersion, requestState>>"
    },
    {
      "id": "M-TLA-RULES-ACTIVE-ATOMIC-001",
      "property": "ActiveVersionChangesAtomically",
      "operator": "publish-active-pointer-during-compile",
      "from": "/\\ candidatePhase' = \"Compiled\"\n    /\\ Record(\"Compile\", {})\n    /\\ UNCHANGED <<activeVersion, requestState, requestVersion>>",
      "to": "/\\ candidatePhase' = \"Compiled\"\n    /\\ activeVersion' = CandidateVersion\n    /\\ Record(\"Compile\", {})\n    /\\ UNCHANGED <<requestState, requestVersion>>"
    },
    {
      "id": "M-TLA-RULES-ATOMIC-001",
      "property": "AtomicRulesetActivation",
      "operator": "activate-composite-before-all-checks",
      "from": "/\\ candidatePhase = \"Checked\"\n    /\\ candidatePhase' = \"Active\"",
      "to": "/\\ candidatePhase = \"Compiled\"\n    /\\ candidatePhase' = \"Active\""
    }
  ]
}
