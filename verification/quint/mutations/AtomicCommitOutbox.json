{
  "schemaVersion": 1,
  "model": "AtomicCommitOutbox",
  "mutations": [
    {
      "id": "M-FORMAL-COMMIT-ATOMIC-001",
      "property": "AtomicCommit",
      "operator": "publish-staged-document-before-commit",
      "from": "observable' = observable,\n    staged' = staged.union(Set(doc)),",
      "to": "observable' = {\n      documents: observable.documents.set(doc, observable.documents.get(doc) + 1),\n      outbox: observable.outbox,\n      transactionState: observable.transactionState,\n    },\n    staged' = staged.union(Set(doc)),"
    },
    {
      "id": "M-FORMAL-OUTBOX-COMPLETE-001",
      "property": "OutboxCompleteness",
      "operator": "omit-committed-outbox-events",
      "from": "outbox: observable.outbox.union(stagedEvents),\n        transactionState: \"Committed\",",
      "to": "outbox: observable.outbox,\n        transactionState: \"Committed\","
    },
    {
      "id": "M-FORMAL-TXN-PARTIAL-001",
      "property": "NoPartialTransaction",
      "operator": "publish-only-one-staged-document",
      "from": "documents: publishDocs,\n        outbox: observable.outbox.union(stagedEvents),",
      "to": "documents: DOCS.mapBy(doc => if (doc == \"d1\" and staged.contains(doc)) stagedVersion.get(doc) else observable.documents.get(doc)),\n        outbox: observable.outbox.union(stagedEvents),"
    },
    {
      "id": "M-FORMAL-TXN-CONFLICT-001",
      "property": "ConflictNeverCommits",
      "operator": "allow-conflicted-transaction-to-commit",
      "from": "not(hasConflict),\n      staged.size() > 0,",
      "to": "true,\n      staged.size() > 0,"
    }
  ]
}
