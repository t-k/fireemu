  "layoutRules": [
    {
      "id": "volatile-edge-header",
      "what": "x-client-data is added to some deliveries by the front end and not to others (names set of one delivery, 16 or 17 names)",
      "rows": 0
    },
    {
      "id": "eta-digits",
      "what": "X-CloudTasks-TaskETA is a Unix time with three to seven fractional digits (a float printed without trailing zeros)",
      "rows": 0
    },
    {
      "id": "numeric-id-length",
      "what": "a generated task id is a decimal number of 19 or 20 digits",
      "rows": 0
    },
    {
      "id": "attempt-count-jitter",
      "what": "the number of attempts of a queue whose retry window does not bound them differs by at most {\"window-six\":100}",
      "rows": 0
    }
  ],
  "knownDifferences": [
    {
      "id": "KD-LOCAL-URL",
      "cases": "*",
      "part": "admission",
      "ruling": 3,
      "what": "The task's httpRequest.url in an answer is the function's own URL: a Cloud Run URL in production, the daemon's route here. The daemon refuses a task that names another URL, so this is the one address it can echo.",
      "paths": ["/^\\/body\\/httpRequest\\/url$/"],
      "rows": 54
    },
    {
      "id": "KD-QUEUE-READS",
      "cases": [
        "get-dup-sched",
        "get-dup-first",
        "queue-tqdef",
        "queue-tqretry",
        "queue-tqlimit",
        "queue-tqwindow",
        "queue-tqconc1",
        "queue-tqconc2",
        "queue-tqrate",
        "queue-tqdead",
        "queue-absent"
      ],
      "part": "admission",
      "ruling": 3,
      "what": "getTask and getQueue are the Cloud Tasks management API, which neither fireemu nor the official emulator serves (405 here); the recordings are read-back evidence of the queue settings and of the task states, not a claim.",
      "paths": ["/.*/"],
      "rows": 11
    },
    {
      "id": "KD-OIDC-TOKEN",
      "cases": "*",
      "part": "deliveries",
      "ruling": 3,
      "what": "Production delivers an OIDC Authorization header (a Bearer with three segments) and the task's own Authorization header is replaced by it; fireemu has no issuer to mint one, so no Authorization arrives and the SDK's auth context is absent (hasAuth).",
      "paths": [],
      "rows": 50
    },
    {
      "id": "KD-PLATFORM-HEADERS",
      "cases": "*",
      "part": "deliveries",
      "ruling": 3,
      "what": "Cloud Run's front end adds forwarded, host, traceparent, x-cloud-trace-context, x-forwarded-for, x-forwarded-proto and accept-encoding to every delivery, and the daemon's own HTTP/1.1 hop adds connection; none has a counterpart on the other side (the platform is outside the claim).",
      "paths": [],
      "rows": 50
    },
    {
      "id": "KD-LOCAL-PATH",
      "cases": "*",
      "part": "deliveries",
      "ruling": 3,
      "what": "A delivery's path is `/` in production; the daemon's runner routes on the function's public path, `/<project>/<region>/<function>`.",
      "paths": ["/^\\[\\]\\/request\\/path$/"],
      "rows": 50
    }
  ],
  "properties": [
    {
      "id": "conc1-max-overlap",
      "what": "a queue with maxConcurrentDispatches 1 runs one delivery at a time",
      "left": 1,
      "right": 1,
