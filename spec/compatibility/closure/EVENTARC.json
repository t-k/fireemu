  "scopeDecisions": [
    {
      "id": "E1",
      "decision": "Target Eventarc Standard channels used by Firebase custom events: the Admin SDK default channel and a named channel. Include owned provider-less channel create/get/list/delete if production supports it; otherwise record the observed refusal and classify channel lifecycle outside this parent. Provider-linked third-party channels and Eventarc Advanced are outside this parent.",
      "rationale": "Channel lifecycle applicability is an explicit conditional decision, established by recorded production answers rather than the local implementation.",
      "status": "FROZEN",
      "decidedBy": "coordinator (delegated by owner)",
      "decidedOn": "2026-09-30",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-30 PUBSUB and EVENTARC scope: coordinator rulings)"
    },
    {
      "id": "E2",
      "decision": "1st gen, Audit Logs and other managed providers, Eventarc Advanced, Firebase alerts, Blocking Auth, task queues, scheduled functions, HTTP/callable product behavior, scaling and billing are outside this parent. The google sentinel and emulator registration/getTriggers/reload endpoints are local regressions only.",
      "rationale": "This parent covers custom events delivered to v2 onCustomEventPublished; other event sources and products have separate scope.",
      "status": "FROZEN",
      "decidedBy": "coordinator (delegated by owner)",
      "decidedOn": "2026-09-30",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-30 PUBSUB and EVENTARC scope: coordinator rulings)"
    },
    {
      "id": "E3",
      "decision": "Include JSON, text and binary publications. Observe type/source/extension filter acceptance or control-plane refusal and the handler-visible event shape; do not assume arbitrary attribute filters are supported.",
      "rationale": "The current converter does not support binary payloads; implementation absence is debt, while production refusal is recorded explicitly.",
      "status": "FROZEN",
      "decidedBy": "coordinator (delegated by owner)",
      "decidedOn": "2026-09-30",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-30 PUBSUB and EVENTARC scope: coordinator rulings)"
    },
    {
      "id": "E4",
      "decision": "Use the same pinned fixture source and SDKs in production and fireemu, in us-central1. Capture deliveries through an owned fixture using the existing Functions deployment and recording structure.",
      "rationale": "The observation sink, grants, deployment side effects and image cleanup are reviewed in a separate pre-send packet; no shared Auth, Rules or channel modification is implied.",
      "status": "FROZEN",
      "decidedBy": "coordinator (delegated by owner)",
      "decidedOn": "2026-09-30",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-30 PUBSUB and EVENTARC scope: coordinator rulings)"
    }
  ],
