{
  "schemaVersion": 1,
  "model": "EventDelivery",
  "mutations": [
    {
      "id": "M-TLA-EVENT-TERMINAL-001",
      "property": "NoTerminalRegression",
      "operator": "allow-cancel-from-terminal-state",
      "from": "/\\ state[e] \\in NonTerminal\n    /\\ state' = [state EXCEPT ![e] = \"Cancelled\"]",
      "to": "/\\ state[e] \\in States\n    /\\ state' = [state EXCEPT ![e] = \"Cancelled\"]"
    },
    {
      "id": "M-TLA-EVENT-LIVENESS-001",
      "property": "EventEventuallyTerminates",
      "operator": "remove-worker-fairness",
      "from": "Fairness == \\A e \\in Events: WF_vars(Progress(e))",
      "to": "Fairness == TRUE"
    },
    {
      "id": "M-TLA-EVENT-LEGAL-001",
      "property": "LegalStateTransitions",
      "operator": "retry-due-from-leased",
      "from": "/\\ state[e] = \"RetryWaiting\"\n    /\\ state' = [state EXCEPT ![e] = \"Pending\"]",
      "to": "/\\ state[e] = \"Leased\"\n    /\\ state' = [state EXCEPT ![e] = \"Pending\"]"
    },
    {
      "id": "M-TLA-EVENT-ATTEMPTS-001",
      "property": "AttemptsChangeOnlyOnStart",
      "operator": "start-without-incrementing-attempts",
      "from": "/\\ attempts' = [attempts EXCEPT ![e] = attempts[e] + 1]\n    /\\ RecordEvent(\"Start\", e)\n    /\\ UNCHANGED <<eventEpoch, epoch>>",
      "to": "/\\ RecordEvent(\"Start\", e)\n    /\\ UNCHANGED <<attempts, eventEpoch, epoch>>"
    },
    {
      "id": "M-TLA-EVENT-STALE-001",
      "property": "StaleDiscardRequiresOlderEpoch",
      "operator": "discard-current-epoch-event",
      "from": "/\\ eventEpoch[e] < epoch\n    /\\ state' = [state EXCEPT ![e] = \"DiscardedStaleEpoch\"]",
      "to": "/\\ eventEpoch[e] <= epoch\n    /\\ state' = [state EXCEPT ![e] = \"DiscardedStaleEpoch\"]"
    }
  ]
}
