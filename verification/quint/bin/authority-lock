#!/usr/bin/env python3
"""Hold the process-wide Apalache endpoint lock across an authority pass."""

import fcntl
import os
import stat
import sys
import tempfile


def main() -> None:
    if len(sys.argv) < 2:
        raise SystemExit("usage: authority-lock COMMAND [ARG ...]")
    lock_path = os.environ.get(
        "FIREEMU_QUINT_AUTHORITY_LOCK",
        os.path.join(tempfile.gettempdir(), "fireemu-quint-apalache-8822.lock"),
    )
    flags = os.O_CREAT | os.O_RDWR
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(lock_path, flags, 0o600)
    metadata = os.fstat(descriptor)
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid():
        os.close(descriptor)
        raise SystemExit("authority lock must be a regular file owned by the current user")
    os.fchmod(descriptor, 0o600)
    fcntl.flock(descriptor, fcntl.LOCK_EX)
    os.set_inheritable(descriptor, True)
    os.environ["FIREEMU_QUINT_AUTHORITY_LOCK_FD"] = str(descriptor)
    os.execvp(sys.argv[1], sys.argv[1:])


if __name__ == "__main__":
    main()
