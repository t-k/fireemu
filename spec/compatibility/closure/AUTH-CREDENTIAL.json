  "oracleTrack": "disposable-sandbox",
  "closureReview": {
    "decision": "APPROVED",
    "decidedOn": "2026-09-24",
    "reviewer": "independent clean-context closure and security review (round 2; round 1 found no blocker and three Should items, fixed in 825d958a6)",
    "reviewedCommit": "014a3277f",
    "finalArtifactSha256": "6297bdcd647e8d1f97b6d1d63a41aadeb7d203214b5022bc29ec80e31740ff97",
    "followUps": "Non-blocking items are tracked outside the closure: a misplaced doc comment in the Auth store, a production-shaped placeholder API key in the corpus to replace at the next re-record, and emulator-profile tests for secure tokens without returnSecureToken and for the expiry allowance.",
    "report": "docs.local/instructions/2026-09-24-auth-credential-closure-review-2.md (private; round 1 in -closure-review-1.md, the promotion review in -promotion-review.md)"
  },
  "scopeDecisions": [
    {
      "id": "C1",
      "decision": "Closure is defined by these behavioral acceptance conditions, observed through the REST surface (Identity Toolkit and Secure Token) on the disposable Identity Platform sandbox, as for AUTH-ACCOUNT.",
      "decidedBy": "owner (t-k)",
      "decidedOn": "2026-09-24"
    },
    {
      "id": "C2",
      "decision": "Client and Admin SDK paths (verifyIdToken, verifySessionCookie, checkRevoked, createCustomToken, client token refresh) belong to AUTH-CONFIG-SDK. Session cookies have no REST consumer, so their verification is SDK behavior; this parent observes their creation and contents.",
      "decidedBy": "owner (t-k)",
      "decidedOn": "2026-09-24",
      "movedTo": "AUTH-CONFIG-SDK"
    },
    {
      "id": "C3",
      "decision": "Token use in Security Rules (request.auth) belongs to FS-RULES; Auth tokens, claims and revocation observed through Firestore belong to AUTH-FS-CROSS.",
      "decidedBy": "owner (t-k)",
      "decidedOn": "2026-09-24",
      "movedTo": "FS-RULES"
    },
    {
      "id": "C4",
      "decision": "Tenant-scoped tokens (tenant custom tokens, the tenant_id claim, tenant session cookies) belong to AUTH-TENANT-BLOCKING, as AUTH-ACCOUNT scope decision A8.",
      "decidedBy": "owner (t-k)",
      "decidedOn": "2026-09-24",
      "movedTo": "AUTH-TENANT-BLOCKING"
    },
    {
      "id": "C5",
      "decision": "Custom-token signatures: production accepts only an RS256 token its issuing service account's Google-held key verifies. fireemu verifies against service-account public keys supplied in its configuration (auth.customTokenSigners, RSA keys of at least 2048 bits) and then refuses damaged signatures, unknown signers and other projects' service accounts as production does. The strict profile accepts no custom token without that configuration (refused with INVALID_CUSTOM_TOKEN, and the startup banner says why); the emulator profile keeps accepting the unsigned JWTs the Admin SDK mints in emulator mode and the official emulator's JSON fake tokens. Key ids and signatures are compared by presence only, because the two sides never hold the same keys.",
      "decidedBy": "owner (t-k)",
      "decidedOn": "2026-09-24",
      "revisedOn": "2026-09-24"
    },
    {
      "id": "C6",
      "decision": "Token refusals after disable, delete and password change are counted once in AUTH-ACCOUNT (its scope decision A6); this parent references them and re-verifies them on its own final artifact.",
      "decidedBy": "owner (t-k)",
      "decidedOn": "2026-09-23"
    },
    {
      "id": "C7",
      "decision": "Second-factor token claims (firebase.sign_in_second_factor, firebase.second_factor_identifier) move to AUTH-MFA, federated IdP sessions (signInWithIdp) to AUTH-FEDERATION, following AUTH-ACCOUNT scope decision A4, and email-link sessions to AUTH-ACTION. AUTH-ACCOUNT A10 moved only the MFA factors of imported accounts, not these token claims, so they are added to the required conditions of the three receiving parents (their rows in docs/compatibility/ip-fs-production-compatibility.md and their preparation pages) rather than inherited.",
      "decidedBy": "owner (t-k)",
      "decidedOn": "2026-09-24",
      "movedTo": "AUTH-MFA"
    },
    {
      "id": "C8",
      "decision": "Any HTTP 429 or quota refusal in this corpus is classified INDETERMINATE; quotas belong to AUTH-CONFIG-SDK, as AUTH-ACCOUNT scope decision A7.",
      "decidedBy": "owner (t-k)",
      "decidedOn": "2026-09-23",
      "movedTo": "AUTH-CONFIG-SDK"
    },
    {
      "id": "C9",
      "decision": "The final-artifact regression re-runs the AUTH-ACCOUNT corpus and inherits its one documented divergence: AUTH-ACCOUNT scope decision A12, the gson parser message text for malformed customAttributes JSON.",
      "decidedBy": "owner (t-k)",
      "decidedOn": "2026-09-24"
    }
  ],
