{
  "schemaVersion": 1,
  "model": "RegexAuthorization",
  "mutations": [
    {
      "id": "M-FORMAL-RULES-REGEX-001",
      "property": "AlternativesDecide",
      "operator": "prefer-regex-exhaustion-over-a-holding-allow",
      "from": "if (parent == Matched or nested == Matched) Matched\n    else if (parent == Exhausted or nested == Exhausted) Exhausted",
      "to": "if (parent == Exhausted or nested == Exhausted) Exhausted\n    else if (parent == Matched or nested == Matched) Matched"
    },
    {
      "id": "M-FORMAL-RULES-REGEX-002",
      "property": "ExhaustionNeverAllows",
      "operator": "exhaustion-counts-as-a-match",
      "from": "    if (outcome == Exhausted) Exhausted\n    else if (negated) {",
      "to": "    if (outcome == Exhausted) Matched\n    else if (negated) {"
    },
    {
      "id": "M-FORMAL-RULES-REGEX-003",
      "property": "CapStops",
      "operator": "never-stop-at-the-exhaustion-cap",
      "from": "    else if (prior + exhausted(parent) + exhausted(nested) > CAP) \"Deny\"",
      "to": "    else if (prior + exhausted(parent) + exhausted(nested) > CAP + 10) \"Deny\""
    }
  ]
}
