#!/usr/bin/env bash
# Local runtime-test gate.
#
# The automatic pull-request job only formats and compiles (`cargo check`); it runs no test.
# This gate runs `cargo nextest` through the session wrapper and writes a small JSON report
# that says what was actually executed: the commit, whether the tree was dirty, the nextest
# profile, the arguments, and the counts of tests run, passed, failed and skipped. It fails
# when nextest fails, when nextest is not installed, and when no test ran at all, so an
# empty selection or a missing dependency is never mistaken for a pass.
#
#   scripts/local-regression-gate --session <name> --report <file.json> [--profile pr] -- <nextest run arguments>
#
# Example:
#   scripts/local-regression-gate --session compat --report docs.local/gates/compat.json -- -p fireemu-core-firestore
set -uo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: scripts/local-regression-gate --session <name> --report <file.json> [--profile <nextest profile>] -- <cargo nextest run arguments>
EOF
  exit 2
}

session=
report=
profile="pr"

while (($#)); do
  case "$1" in
    --session)
      (($# >= 2)) || usage
      session=$2
      shift 2
      ;;
    --report)
      (($# >= 2)) || usage
      report=$2
      shift 2
      ;;
    --profile)
      (($# >= 2)) || usage
      profile=$2
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *)
      usage
      ;;
  esac
done

[[ -n "$session" && -n "$report" ]] || usage
[[ "$profile" =~ ^[a-z0-9][a-z0-9_-]{0,63}$ ]] || {
  printf 'local-regression-gate: invalid profile name: %s\n' "$profile" >&2
  exit 2
}

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
wrapper="$here/cargo-session"

json_string() {
  # NUL cannot occur in a Bash argument. Escape every other JSON control byte,
  # not just newline/tab: a valid test-filter argument must never corrupt a receipt.
  local value=$1 code octal character escaped
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  for ((code = 1; code < 32; code++)); do
    printf -v octal '%03o' "$code"
    printf -v character '%b' "\\$octal"
    printf -v escaped '\\u%04x' "$code"
    value=${value//"$character"/"$escaped"}
  done
  printf '"%s"' "$value"
}

json_array() {
  local first=true item
  printf '['
  for item in "$@"; do
    $first || printf ','
    first=false
    json_string "$item"
  done
  printf ']'
}

commit=$(git rev-parse HEAD 2>/dev/null || printf 'unknown')
if [[ -n "$(git status --porcelain 2>/dev/null)" ]]; then dirty=true; else dirty=false; fi
started=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# Never reuse or overwrite a prior result, including a dangling symlink. A
# same-directory temporary file is published using an exclusive hard link below.
report_dir=$(dirname -- "$report")
if ! mkdir -p -- "$report_dir" || [[ -e "$report" || -L "$report" ]]; then
  printf 'local-regression-gate: a new writable report path is required: %s\n' "$report" >&2
  exit 73
fi
report_tmp=$(mktemp "$report_dir/.runtime-report.XXXXXXXX") || exit 73
log=
trap 'rm -f -- "$report_tmp" "${log:-}"' EXIT

status=
summary=
exit_status=0
run=0
passed=0
failed=0
skipped=0
nextest_version=
rustc_version=$(rustc --version 2>/dev/null || printf 'unknown')

if ! nextest_version=$(cargo nextest --version 2>/dev/null | head -n 1) || [[ -z "$nextest_version" ]]; then
  status=missing-dependency
  exit_status=127
  printf 'local-regression-gate: cargo-nextest is not installed; nothing was tested (install it with cargo install cargo-nextest --locked)\n' >&2
else
  log=$(mktemp "${TMPDIR:-/tmp}/local-regression-gate.XXXXXX") || exit 73
  "$wrapper" --session "$session" -- cargo nextest run --profile "$profile" "$@" 2>&1 | tee "$log"
  pipeline_status=("${PIPESTATUS[@]}")
  exit_status=${pipeline_status[0]}
  summary=$(grep -E '^[[:space:]]*Summary \[' "$log" | tail -n 1 || true)
  if ((pipeline_status[1] != 0)); then
    status=recording-failed
    ((exit_status != 0)) || exit_status=74
    printf 'local-regression-gate: test log could not be recorded\n' >&2
  elif [[ -z "$summary" ]]; then
    status=no-summary
    printf 'local-regression-gate: nextest printed no summary line; the run is not evidence\n' >&2
  else
    # "Summary [   1.234s] 12 tests run: 11 passed (1 slow), 1 failed, 3 skipped"
    run=$(sed -nE 's/.* ([0-9]+) tests? run: .*/\1/p' <<<"$summary")
    passed=$(sed -nE 's/.* ([0-9]+) passed.*/\1/p' <<<"$summary")
    failed=$(sed -nE 's/.* ([0-9]+) failed.*/\1/p' <<<"$summary")
    skipped=$(sed -nE 's/.* ([0-9]+) skipped.*/\1/p' <<<"$summary")
    invalid_counts=false
    # Reject malformed/overflowing counters before Bash arithmetic. The bound is
    # below signed 64-bit range; it is a parser bound, not a test selection cap.
    for count_name in run passed failed skipped; do
      value=${!count_name}
      value=${value:-0}
      if [[ ! "$value" =~ ^[0-9]{1,18}$ ]]; then
        invalid_counts=true
        printf -v "$count_name" '%d' 0
      else
        printf -v "$count_name" '%d' "$((10#$value))"
      fi
    done
    if [[ "$invalid_counts" == true ]]; then
      status=invalid-summary
      printf 'local-regression-gate: unparseable test counters\n' >&2
    elif ((run == 0)); then
      status=no-tests
      printf 'local-regression-gate: no test ran; an empty selection is not a pass\n' >&2
    elif ((exit_status != 0)) || ((failed > 0)); then
      status=failed
    elif ((passed != run)); then
      status=incomplete-summary
      printf 'local-regression-gate: not every executed test is accounted for as passed\n' >&2
    else
      status=passed
    fi
  fi
  if ((run == 0)) && ((exit_status == 0)); then
    exit_status=4
  fi
fi

# Normalize the result before publishing: the receipt and process exit must agree.
if [[ "$status" != passed ]] && ((exit_status == 0)); then
  exit_status=1
fi
finished=$(date -u +%Y-%m-%dT%H:%M:%SZ)
report_data=$(cat <<EOF
{
  "schemaVersion": 1,
  "kind": "runtime-tests",
  "status": $(json_string "$status"),
  "commit": $(json_string "$commit"),
  "dirty": $dirty,
  "session": $(json_string "$session"),
  "profile": $(json_string "$profile"),
  "arguments": $(json_array "$@"),
  "nextest": $(json_string "$nextest_version"),
  "rustc": $(json_string "$rustc_version"),
  "summary": $(json_string "$summary"),
  "counts": {"run": $run, "passed": $passed, "failed": $failed, "skipped": $skipped},
  "exitStatus": $exit_status,
  "startedAt": $(json_string "$started"),
  "finishedAt": $(json_string "$finished")
}
EOF
) || exit 74
if ! printf '%s\n' "$report_data" >"$report_tmp"; then
  printf 'local-regression-gate: report write failed\n' >&2
  exit 74
fi
# ln cannot truncate a pre-existing file. Verify the exact destination as well:
# portable ln otherwise accepts a directory (or directory symlink) created in the
# race window and links *inside* it instead of publishing the requested pathname.
if ! ln -- "$report_tmp" "$report" ||
   [[ ! -f "$report" || -L "$report" || ! "$report_tmp" -ef "$report" ]]; then
  printf 'local-regression-gate: report publication failed: %s\n' "$report" >&2
  exit 73
fi

printf 'local-regression-gate: %s (%d run, %d passed, %d failed, %d skipped) at %s%s; report %s\n' \
  "$status" "$run" "$passed" "$failed" "$skipped" "${commit:0:12}" "$([[ $dirty == true ]] && printf ' (dirty)')" "$report" >&2

if [[ "$status" == passed ]]; then
  exit 0
fi
if ((exit_status == 0)); then
  exit_status=1
fi
exit "$exit_status"
