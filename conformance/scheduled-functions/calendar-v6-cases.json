    "id": "tz01",
    "conditionId": "SCHEDULED-FUNCTIONS/timezone-validation-defaults",
    "case": "explicit-UTC",
    "schedule": "0 9 * * *",
    "timeZone": "UTC",
    "alsoCovers": [
      { "conditionId": "SCHEDULED-FUNCTIONS/retry-config-validation", "case": "omitted-options" }
    ],
    "note": "One create serves two frozen cases: an explicit UTC zone and no retryConfig or attemptDeadline are the same request as the omitted-options case, so a second job would add cost and no evidence"
  },
