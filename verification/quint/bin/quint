#!/bin/sh
set -eu

: "${QUINT_REAL_BIN:?QUINT_REAL_BIN must point to the pinned Quint executable}"
case "$QUINT_REAL_BIN" in
  /*) ;;
  *)
    echo "error: QUINT_REAL_BIN must be absolute" >&2
    exit 126
    ;;
esac

if [ ! -x "$QUINT_REAL_BIN" ]; then
  echo "error: QUINT_REAL_BIN is not executable" >&2
  exit 126
fi

timeout_seconds="${QUINT_TIMEOUT_SECONDS:-120}"
case "$timeout_seconds" in
  ''|*[!0-9]*|0)
    echo "error: QUINT_TIMEOUT_SECONDS must be a positive integer" >&2
    exit 126
    ;;
esac

if ! command -v timeout >/dev/null 2>&1; then
  echo "error: GNU timeout is required" >&2
  exit 126
fi

timeout_pid=
stop_timeout_group() {
  if [ -z "$timeout_pid" ]; then
    return
  fi

  kill -TERM -- "-$timeout_pid" 2>/dev/null || kill -TERM "$timeout_pid" 2>/dev/null || true
  (
    sleep 1
    kill -KILL -- "-$timeout_pid" 2>/dev/null || true
    kill -KILL "$timeout_pid" 2>/dev/null || true
  ) &
  escalation_pid=$!

  set +e
  wait "$timeout_pid" 2>/dev/null
  set -e
  if kill -0 -- "-$timeout_pid" 2>/dev/null; then
    set +e
    wait "$escalation_pid" 2>/dev/null
    set -e
  else
    kill -TERM "$escalation_pid" 2>/dev/null || true
    set +e
    wait "$escalation_pid" 2>/dev/null
    set -e
  fi
  timeout_pid=
}

handle_signal() {
  status=$1
  trap - HUP INT TERM
  stop_timeout_group
  exit "$status"
}

trap 'handle_signal 129' HUP
trap 'handle_signal 130' INT
trap 'handle_signal 143' TERM

set +e
timeout --signal=TERM --kill-after=5s "${timeout_seconds}s" "$QUINT_REAL_BIN" "$@" &
timeout_pid=$!
wait "$timeout_pid"
status=$?
timeout_pid=
set -e
trap - HUP INT TERM

case "$status" in
  124|137) exit 124 ;;
  *) exit "$status" ;;
esac
