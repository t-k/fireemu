{
  "name": "firebase-testd-ui",
  "version": "0.1.0",
  "private": true,
  "description": "The firebase-testd Emulator UI (Solid + Vite + Tailwind), embedded into the daemon at build time.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "oxlint src e2e",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "neverthrow": "^8.2.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.32.1"
}
