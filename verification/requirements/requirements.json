    {
      "id": "INV-AUTH-001",
      "statement": "A TOTP code for a time step at or below the last accepted step is never accepted again.",
      "criticality": "critical",
      "owner": "core-auth",
      "status": "implemented",
      "artifacts": {
        "tla": "AuthTotp.tla::NoTotpCodeReuse",
        "loom": [
          "totp_verify_races_with_clock_advance"
        ],
        "kani": "pending:totp_window_boundary",
        "property": "prop_same_step_same_code",
        "mutation": [
          "M-AUTH-001",
          "M-AUTH-002"
        ],
        "integration": [
          "crates/ftd-core-auth/tests/mfa.rs",
          "crates/ftd-core-auth/tests/totp.rs"
        ]
      },
      "note": "The Kani harness is pending: the acceptance window is decided from HMAC-SHA1 codes and from a 128-bit division in time_step, which bounded model checking does not finish in usable time. The window and replay boundary are covered by AuthTotp.tla, prop_same_step_same_code and the RFC 6238 vectors in crates/ftd-core-auth/tests/totp.rs."
    },
