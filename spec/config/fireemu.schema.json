{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fireemu.dev/spec/config/fireemu.schema.json",
  "title": "fireemu canonical configuration",
  "description": "Single source of truth for the daemon configuration (spec section 17). Unknown keys are errors everywhere. Cross-field constraints that JSON Schema cannot express are enforced by tools/config-schema-check and by the Rust config loader.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "firestore"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://fireemu.dev/spec/config/fireemu.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "firebaseJson": {
      "type": "string",
      "minLength": 1,
      "description": "Firebase project configuration loaded relative to this canonical file."
    },
    "profile": {
      "description": "Compatibility profile (spec/compatibility/contract.json). strict behaves like production Firebase where the official emulators do not (composite index validation with production's rules, Standard query limits, ID-token verification); emulator reproduces the pinned official emulators, including their documented limitations. The profile decides the index validation and the ID-token semantics of the Security Rules surfaces and sets the default of firestore.enforceLimits; an explicit enforceLimits wins over it.",
      "enum": ["strict", "emulator"],
      "default": "strict"
    },
    "bind": { "type": "string", "default": "127.0.0.1" },
    "projects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requireDemoPrefix": { "type": "boolean", "default": true }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "catalog": { "type": "string", "pattern": "^firestore-(standard|enterprise-native)-[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "queryCatalog": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^firestore-standard-query-[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
          ]
        },
        "rulesCatalog": { "type": "string", "pattern": "^firebase-rules-[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "enforcement": { "enum": ["strict", "observe"] },
        "warningThresholds": { "$ref": "#/$defs/thresholds" },
        "perLimitWarningThresholds": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Z0-9-]+$" },
          "additionalProperties": { "$ref": "#/$defs/thresholds" }
        },
        "warningsAsErrors": {
          "type": "array",
          "items": { "type": "string", "pattern": "^([A-Z0-9-]+|notice|warning|critical)$" },
          "uniqueItems": true
        },
        "quotaAccounting": { "enum": ["off", "observe", "enforce"] },
        "firestorePlan": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "billingEnabled": { "type": "boolean" },
            "compositeIndexLimitOverride": { "$ref": "#/$defs/optionalCount" },
            "singleFieldConfigLimitOverride": { "$ref": "#/$defs/optionalCount" },
            "enterpriseIndexLimitOverride": { "$ref": "#/$defs/optionalCount" }
          }
        }
      }
    },
    "firestore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edition", "apiMode"],
      "properties": {
        "edition": { "enum": ["standard", "enterprise"] },
        "apiMode": { "enum": ["native", "mongodb-compatible"] },
        "indexFile": { "type": "string" },
        "textIndexDefinitionFile": { "type": "string" },
        "enforceLimits": { "type": "boolean" },
        "databaseCreateTime": {
          "type": "string",
          "format": "date-time",
          "description": "When the daemon's databases were created: the createTime they report and the instant before which a read_time is refused with INVALID_ARGUMENT. Defaults to the daemon's start; a run compared with a production database names that database's createTime. It must not be after the clock start."
        },
        "ttlSweepIntervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 259200,
          "default": 86400,
          "description": "How long a document whose time-to-live field has expired stays readable before the expiry sweep deletes it. Production deletes an expired document typically within 24 hours and within 72 hours at worst, so the default is 86400 and the maximum is the documented outer bound of 259200."
        },
        "explain": { "type": "boolean" },
        "pipeline": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "executionMode": { "enum": ["strict-native", "proxy", "record-only"] },
            "unknownStagePolicy": { "enum": ["reject"] },
            "writeStagePolicy": { "enum": ["reject-unimplemented"] }
          }
        },
        "textSearch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fidelity": { "enum": ["strict-validation-only", "deterministic-basic", "external-analyzer", "upstream-proxy"] },
            "analyzer": { "type": "string" },
            "scorePrecision": { "enum": ["exact", "approximate", "oracle-only", "unsupported"] },
            "multipleIndexPolicy": { "enum": ["warn-and-deterministic", "reject", "oracle"] },
            "indexBuildPolicy": { "enum": ["synchronous", "virtual-async", "manual"] },
            "visibilityPolicy": { "enum": ["atomic-with-commit", "virtual-lag", "oracle-defined"] },
            "visibilityLag": {
              "oneOf": [
                { "type": "null" },
                { "type": "object", "additionalProperties": false, "required": ["maxLogicalDelayMillis"], "properties": { "maxLogicalDelayMillis": { "type": "integer", "minimum": 0 } } }
              ]
            },
            "queryLanguagePolicy": { "enum": ["index-default-or-autodetect", "detect-query-text", "analyze-per-indexed-language", "oracle-defined"] },
            "backendDefaultLanguageOverride": { "enum": ["implicit-language-field", "disabled", "unresolved"] },
            "snapshotPolicy": { "enum": ["materialized", "rebuild"] },
            "warnings": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "broadCandidateCount": { "type": "integer", "minimum": 0 },
                "scoreCandidateCount": { "type": "integer", "minimum": 0 },
                "warningsAsErrors": { "type": "array", "items": { "type": "string", "pattern": "^FS_[A-Z0-9_]+$" }, "uniqueItems": true }
              }
            }
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executionMode": { "enum": ["admin-bypass", "native", "oracle", "disabled"] },
        "source": { "type": "string" },
        "staticLimitChecks": { "type": "boolean" },
        "runtimeBudgets": { "type": "boolean" },
        "compiledSize": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["estimate", "off"] },
            "oracle": { "enum": ["off", "projects-test", "disposable-ruleset"] }
          }
        },
        "diagnostics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": { "enum": ["human", "json", "sarif"] },
            "largestContributors": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "projectIssuer": { "type": "string", "pattern": "^https://securetoken\\.google\\.com/[a-z0-9-]+$" },
        "idTokenSigning": { "enum": ["session-rsa", "unsigned-emulator"] },
        "apiKeys": {
          "type": "array",
          "minItems": 1,
          "description": "The default project's Web API keys. When present, a client request with any other key is refused with production's 400 API_KEY_INVALID before the service reads it; when absent, any key is accepted, as by the official emulator.",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
        },
        "customTokenSigners": {
          "type": "object",
          "description": "Service accounts whose signed custom tokens are accepted, each mapped to its public JWK set (the document Google publishes at https://www.googleapis.com/service_accounts/v1/jwk/<service account>). When present, signInWithCustomToken accepts only RS256 tokens these keys verify and refuses a verifying token of another project's service account with CREDENTIAL_MISMATCH, as production does. When absent, the unsigned tokens the Admin SDK mints in emulator mode are accepted.",
          "propertyNames": { "pattern": "^[^@\\s]+@([a-z0-9-]+\\.iam|appspot)\\.gserviceaccount\\.com$" },
          "additionalProperties": {
            "type": "object",
            "required": ["keys"],
            "properties": {
              "keys": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["kty", "n", "e"],
                  "properties": {
                    "kty": { "const": "RSA" },
                    "alg": { "const": "RS256" },
                    "kid": { "type": "string" },
                    "n": { "type": "string" },
                    "e": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "totp": {
          "type": "object",
          "description": "Explicitly enables fireemu's TOTP extension. When absent, TOTP enrollment matches the official Auth emulator and is rejected.",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "digits": { "type": "integer", "minimum": 6, "maximum": 8 },
            "windowSteps": { "type": "integer", "minimum": 0, "maximum": 10 },
            "enrollmentSessionTtlSeconds": { "type": "integer", "minimum": 1 }
          }
        },
        "secretMaterialization": { "enum": ["redact", "allow"] },
        "forwardInboundCredentials": {
          "type": "boolean",
          "description": "Allow blocking Auth Functions to receive caller-supplied IdP access, ID and refresh tokens. Defaults to false."
        },
        "improvedEmailPrivacy": {
          "type": "boolean",
          "description": "Email enumeration protection, as production enables it for every new project: wrong-password and unknown-address sign-ins answer INVALID_LOGIN_CREDENTIALS and a password reset for an unknown address is acknowledged. Defaults to true; false restores the official Auth emulator's EMAIL_NOT_FOUND and INVALID_PASSWORD answers."
        },
        "signIn": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowDuplicateEmails": { "type": "boolean", "default": false }
          }
        },
        "client": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "permissions": { "$ref": "#/$defs/authClientPermissions" }
          }
        },
        "configOverrides": {
          "type": "array",
          "items": { "$ref": "#/$defs/authConfigOverride" },
          "description": "Explicit project/tenant overrides for client.permissions and improvedEmailPrivacy. Password policies use passwordPolicyOverrides."
        },
        "blockingFunctions": { "$ref": "#/$defs/blockingFunctions" },
        "quota": { "$ref": "#/$defs/authQuota" },
        "quotaSimulation": { "$ref": "#/$defs/authQuotaSimulation" },
        "logActionCodes": {
          "type": "boolean",
          "description": "Print every email action link and SMS verification code to the daemon's standard output (and the Logging emulator) as the official Auth emulator does. Defaults to true. These lines carry credentials: set false where the console is shared or captured, and read the codes from /emulator/v1/projects/{project}/oobCodes and verificationCodes instead. --log-verbosity quiet also silences them."
        },
        "passwordPolicy": { "$ref": "#/$defs/passwordPolicy" },
        "passwordPolicyOverrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["projectId", "passwordPolicy"],
            "properties": {
              "projectId": { "type": "string", "minLength": 1 },
              "tenantId": { "type": "string", "minLength": 1 },
              "passwordPolicy": { "$ref": "#/$defs/passwordPolicy" }
            }
          }
        }
      }
    },
    "appCheck": {
      "type": "object",
      "additionalProperties": false,
      "description": "Firebase App Check (docs/specifications/firebase-app-check.md section 8). Defaults to off, so an existing configuration keeps its behaviour. Cross-field rules (a non-off service mode needs enabled, one project ID per project number and back, one app ID per project, an embedded project number that matches) are enforced by tools/config-schema-check and by the Rust loader.",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "tokenSigning": { "enum": ["instance-rsa"], "default": "instance-rsa" },
        "tokenTtlSeconds": { "type": "integer", "minimum": 1800, "maximum": 604800, "default": 3600 },
        "apps": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["projectId", "projectNumber", "appId"],
            "properties": {
              "projectId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
              "projectNumber": { "type": "string", "pattern": "^[1-9][0-9]{0,31}$" },
              "appId": { "type": "string", "minLength": 1, "maxLength": 256 },
              "enabled": { "type": "boolean", "default": true },
              "debugTokenSha256": {
                "type": "array",
                "maxItems": 128,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        },
        "services": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "auth": { "$ref": "#/$defs/appCheckMode" },
            "firestore": { "$ref": "#/$defs/appCheckMode" },
            "storage": { "$ref": "#/$defs/appCheckMode" }
          }
        }
      }
    },
    "daemon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "firestorePort": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "httpPort": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "storagePort": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "functionsPort": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "eventarcPort": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "tasksPort": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "pubsubPort": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "loggingPort": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "clockStart": { "type": "string", "format": "date-time" },
        "seed": { "type": "integer", "minimum": 0 },
        "authProject": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "authProjectNumbers": { "type": "object", "propertyNames": { "pattern": "^[a-z0-9-]+$" }, "additionalProperties": { "$ref": "#/$defs/authProjectNumber" } }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": { "type": "string", "description": "Path of the Storage Security Rules file (service firebase.storage)." },
        "mode": { "enum": ["native"] },
        "objectNameNormalization": { "enum": ["preserve"] },
        "persistence": { "enum": ["memory", "snapshot-files", "redb"] }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "delivery": { "enum": ["exactly-once-test", "at-least-once", "chaos"] },
        "maxAttempts": { "type": "integer", "minimum": 1 }
      }
    },
    "pubsub": {
      "type": "object",
      "description": "Pub/Sub emulator behaviour that the service configuration has no counterpart for.",
      "additionalProperties": false,
      "properties": {
        "pushMinimumRedeliveryIntervalMillis": {
          "description": "Minimum interval kept between two push deliveries of the same message while the subscription has no retry policy. The default 0 follows production, which redelivers as soon as possible without a retry policy; a non-zero interval is an opt-in emulator protection against re-requesting a failing push endpoint with no interval at all. A retry policy always decides its own backoff.",
          "type": "integer",
          "minimum": 0,
          "maximum": 600000,
          "default": 0
        }
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clock": { "enum": ["virtual", "wall"] },
        "defaultTimeZone": { "type": "string" },
        "catchUp": { "enum": ["all", "latest", "none"] },
        "maxCatchUpRuns": { "type": "integer", "minimum": 0 },
        "overlap": { "enum": ["allow", "skip", "queue", "reject"] }
      }
    },
    "functions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest": { "type": "string" },
        "source": { "type": "string", "description": "Functions codebase directory loaded by the runner (discovery)." },
        "runner": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "Runner command; default: node tools/runner-node/index.mjs" },
        "maxGlobalConcurrency": { "type": "integer", "minimum": 1 },
        "unservedTriggers": { "enum": ["refuse", "report"], "description": "An exported trigger whose product fireemu does not serve: refuse discovery (default) or report each one and carry on." }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "canonical": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "passwordPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enforcementState"],
      "properties": {
        "enforcementState": { "enum": ["OFF", "ENFORCE"] },
        "forceUpgradeOnSignin": { "type": "boolean", "default": false },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minLength": { "type": "integer", "minimum": 6, "maximum": 30, "default": 6 },
            "maxLength": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 6, "maximum": 4096 }] },
            "requireUppercase": { "type": "boolean", "default": false },
            "requireLowercase": { "type": "boolean", "default": false },
            "requireNumeric": { "type": "boolean", "default": false },
            "requireNonAlphanumeric": { "type": "boolean", "default": false }
          }
        }
      }
    },
    "authClientPermissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disabledUserSignup": { "type": "boolean", "default": false },
        "disabledUserDeletion": { "type": "boolean", "default": false }
      }
    },
    "authConfigOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "config"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "tenantId": { "type": "string", "minLength": 1 },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "client": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "permissions": { "$ref": "#/$defs/authClientPermissions" }
              }
            },
            "improvedEmailPrivacy": { "type": "boolean" }
          }
        }
      }
    },
    "blockingFunctionTrigger": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["function"],
          "properties": {
            "function": { "type": "string", "minLength": 1 },
            "region": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "blockingFunctions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "triggers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "beforeCreate": { "$ref": "#/$defs/blockingFunctionTrigger" },
            "beforeSignIn": { "$ref": "#/$defs/blockingFunctionTrigger" }
          }
        },
        "forwardInboundCredentials": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "idToken": { "type": "boolean", "default": false },
            "accessToken": { "type": "boolean", "default": false },
            "refreshToken": { "type": "boolean", "default": false }
          }
        }
      }
    },
    "authQuota": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "signUpQuotaConfig": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["quota", "startTime", "quotaDuration"],
              "properties": {
                "quota": { "type": "string", "pattern": "^[0-9]+$" },
                "startTime": { "type": "string", "format": "date-time" },
                "quotaDuration": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,9})?s$" }
              }
            }
          ]
        }
      }
    },
    "authQuotaSimulation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["off", "observe", "enforce"], "default": "off" },
        "algorithm": { "enum": ["fixed-window-v1"], "default": "fixed-window-v1" },
        "defaultQuotaPerHour": { "type": "integer", "minimum": 0, "maximum": 1000000, "default": 100 },
        "maxTrackedBuckets": { "type": "integer", "minimum": 1, "maximum": 65536, "default": 4096 }
      }
    },
    "appCheckMode": { "enum": ["off", "unenforced", "enforced"], "default": "off" },
    "authProjectNumber": {
      "type": "string",
      "description": "A positive decimal project number that fits the u64 runtime representation.",
      "oneOf": [
        { "pattern": "^[1-9][0-9]{0,18}$" },
        { "pattern": "^1[0-7][0-9]{18}$" },
        { "pattern": "^18[0-3][0-9]{17}$" },
        { "pattern": "^184[0-3][0-9]{16}$" },
        { "pattern": "^1844[0-5][0-9]{15}$" },
        { "pattern": "^18446[0-6][0-9]{14}$" },
        { "pattern": "^184467[0-3][0-9]{13}$" },
        { "pattern": "^1844674[0-3][0-9]{12}$" },
        { "pattern": "^184467440[0-6][0-9]{10}$" },
        { "pattern": "^1844674407[0-2][0-9]{9}$" },
        { "pattern": "^18446744073[0-6][0-9]{8}$" },
        { "pattern": "^1844674407370[0-8][0-9]{6}$" },
        { "pattern": "^18446744073709[0-4][0-9]{5}$" },
        { "pattern": "^184467440737095[0-4][0-9]{4}$" },
        { "pattern": "^18446744073709550[0-9]{3}$" },
        { "pattern": "^18446744073709551[0-5][0-9]{2}$" },
        { "pattern": "^1844674407370955160[0-9]$" },
        { "pattern": "^1844674407370955161[0-5]$" }
      ]
    },
    "optionalCount": { "oneOf": [ { "type": "null" }, { "type": "integer", "minimum": 0 } ] },
    "thresholds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["basisPoints", "severity"],
        "properties": {
          "basisPoints": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "severity": { "enum": ["notice", "warning", "critical"] }
        }
      }
    }
  }
}
