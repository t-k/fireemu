{
  "schemaVersion": 1,
  "model": "AwaitIdle",
  "mutations": [
    {
      "id": "M-TLA-IDLE-SAFETY-001",
      "property": "NoFalseIdle",
      "operator": "return-before-blocking-work-drains",
      "from": "/\\ Blocking = {}\n    /\\ fenceState' = \"returned\"",
      "to": "/\\ TRUE\n    /\\ fenceState' = \"returned\""
    },
    {
      "id": "M-TLA-IDLE-LIVENESS-001",
      "property": "AwaitIdleEventuallyReturns",
      "operator": "remove-return-idle-fairness",
      "from": "/\\ WF_vars(ReturnIdle)",
      "to": "/\\ TRUE"
    },
    {
      "id": "M-TLA-IDLE-IDENTITY-EXTERNAL-001",
      "property": "NoIdentityReuse",
      "operator": "reuse-external-work-identity",
      "from": "/\\ i \\notin used\n    /\\ FreshAvailable",
      "to": "/\\ TRUE\n    /\\ FreshAvailable"
    },
    {
      "id": "M-TLA-IDLE-IDENTITY-CHILD-001",
      "property": "NoIdentityReuse",
      "operator": "reuse-child-work-identity",
      "from": "/\\ c \\notin used\n    /\\ reserved' = reserved \\ {p}",
      "to": "/\\ TRUE\n    /\\ reserved' = reserved \\ {p}"
    },
    {
      "id": "M-TLA-IDLE-FENCE-ADMISSION-001",
      "property": "FenceClosedToNewExternalWork",
      "operator": "admit-external-work-while-waiting",
      "from": "/\\ fenceState = \"none\"\n    /\\ i \\notin used",
      "to": "/\\ fenceState # \"returned\"\n    /\\ i \\notin used"
    },
    {
      "id": "M-TLA-IDLE-FENCE-LIFECYCLE-001",
      "property": "FenceLifecycleMonotonic",
      "operator": "reopen-returned-fence",
      "from": "/\\ fenceState' = \"returned\"\n    /\\ Record(\"ReturnIdle\", {})\n    /\\ UNCHANGED <<active, reserved, kind, depth, used, fenced>>",
      "to": "/\\ fenceState' = \"none\"\n    /\\ Record(\"ReturnIdle\", {})\n    /\\ UNCHANGED <<active, reserved, kind, depth, used, fenced>>"
    },
    {
      "id": "M-TLA-IDLE-RESERVATION-001",
      "property": "CoveredReservationsBlock",
      "operator": "exclude-covered-reservations-from-blocking",
      "from": "Blocking == (reserved \\cap fenced) \\cup {i \\in active : i \\in fenced /\\ Fenced(i)}",
      "to": "Blocking == {i \\in active : i \\in fenced /\\ Fenced(i)}"
    }
  ]
}
