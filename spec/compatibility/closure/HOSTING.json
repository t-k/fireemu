  "scopeDecisions": [
    {
      "id": "HOSTING-LOCAL-ONLY",
      "decision": "Only local registered Functions targets can be rewritten. No Cloud Run lookup or live Functions fallback is allowed. Missing local targets remain unverified and are not an approved production equivalence.",
      "status": "IMPLEMENTING"
    },
    {
      "id": "HOSTING-ORACLE",
      "decision": "Production is observed only through disposable preview channels (24 hour TTL) of the default site of the Identity Platform sandbox, one channel per site version, through the Hosting REST API. The live channel is never released to and the firebase CLI is not used, so the project's authorized domains are not written. A preview channel is not the live channel: a claim is limited to what a preview channel serves.",
      "status": "IMPLEMENTING"
    },
    {
      "id": "HOSTING-REST-SCOPE",
      "decision": "Function and Cloud Run rewrites are out of scope for this parent (owner ledger 2435). They are recorded as NOT_COMPARED with the official-emulator comparison as their only evidence. The REST API carries a file manifest, so the deploy-time `ignore` rule is not observable in production.",
      "status": "ANSWERED"
    }
  ],
