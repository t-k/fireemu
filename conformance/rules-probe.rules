// The ruleset the language-matrix probe starts from; every chunk replaces it through
// `PUT /emulator/v1/projects/{project}:securityRules`. Denying everything makes a probe that
// never installed its chunk fail loudly rather than silently read `true`.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
