        ]
      }
    },
    {
      "id": "INV-LIMIT-001",
      "statement": "A request that violates a limit or a unique index changes no document, index, outbox or quota state.",
      "criticality": "critical",
      "owner": "core-limits",
      "status": "partial",
      "note": "Disposition engine and boundary semantics are implemented; the atomic rejection on the commit path arrives with the Firestore core (Milestone E), and LimitRejection.tla is pending with it.",
      "artifacts": {
        "tla": "pending:LimitRejection.tla::LimitRejectionAtomicity",
        "kani": "limit_boundary_classification",
        "property": "prop_boundary_reject_precedes_warning",
        "mutation": [
          "M-LIMIT-001",
          "M-LIMIT-002",
          "M-LIMIT-004",
          "M-LIMIT-006"
        ],
        "integration": [
          "crates/ftd-core-limits/tests/evaluate.rs",
          "crates/ftd-core-limits/tests/properties.rs"
        ]
      }
    },
    {
      "id": "INV-COMMIT-001",
