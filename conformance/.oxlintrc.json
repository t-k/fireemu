{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-unused-vars": "error",
    "no-console": "off",
    "no-underscore-dangle": "off",
    "no-await-in-loop": "off",
    "unicorn/consistent-function-scoping": "off"
  },
  "ignorePatterns": [
    "node_modules",
    "fixtures",
    ".runs",
    "src/storage-rules/controller.mjs",
    "src/storage-rules/ledger-revocation.mjs",
    "src/storage-rules/local-smoke.mjs",
    "src/storage-rules/private-inputs.mjs",
    "src/storage-rules/run-ledger.mjs",
    "src/storage-rules/settle.mjs",
    "src/storage-rules/target.mjs"
  ]
}
