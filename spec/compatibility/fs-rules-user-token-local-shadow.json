    ],
    "binary": "fireemu",
    "buildCommand": [
      "cargo",
      "build",
      "--locked",
      "-p",
      "fireemu"
    ],
    "contract": "fs-rules-user-token-shadow-v1",
    "driverEnvironment": [
      "FIRESTORE_EMULATOR_HOST",
      "FIREBASE_AUTH_EMULATOR_HOST"
    ],
    "environmentAllowlist": [
      "PATH",
      "HOME",
      "TMPDIR",
      "LANG",
      "LC_ALL"
    ],
    "forbiddenEnvironment": [
