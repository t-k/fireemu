{
  "schemaVersion": 1,
  "id": "firestore-enterprise-native-2026-08-27",
  "product": "firestore",
  "edition": "enterprise",
  "officialRevision": "Native mode: Quotas and Limits (Firestore Enterprise)",
  "officialLastUpdatedUtc": "2026-08-27",
