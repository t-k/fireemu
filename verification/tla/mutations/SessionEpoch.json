{
  "schemaVersion": 1,
  "model": "SessionEpoch",
  "mutations": [
    {
      "id": "M-TLA-EPOCH-ISOLATION-001",
      "property": "EpochIsolation",
      "operator": "allow-stale-work-to-apply",
      "from": "/\\ workEpoch[w] = epoch\n    /\\ applied' =",
      "to": "/\\ workEpoch[w] # epoch\n    /\\ applied' ="
    },
    {
      "id": "M-TLA-EPOCH-CAPTURE-001",
      "property": "WorkCapturedOnlyWhileActive",
      "operator": "capture-work-outside-active-state",
      "from": "CaptureWork(w) ==\n    /\\ state = \"Active\"",
      "to": "CaptureWork(w) ==\n    /\\ TRUE"
    },
    {
      "id": "M-TLA-EPOCH-MONOTONIC-001",
      "property": "EpochNeverDecreases",
      "operator": "choose-any-reset-epoch",
      "from": "/\\ epoch' = epoch + 1",
      "to": "/\\ epoch' \\in 0..MaxEpoch"
    },
    {
      "id": "M-TLA-RESET-LIVENESS-001",
      "property": "ResetEventuallyActivatesNewEpoch",
      "operator": "remove-reset-completion-fairness",
      "from": "Fairness == WF_vars(CompleteReset)",
      "to": "Fairness == TRUE"
    }
  ]
}
