  "childPid": 28068,
  "contract": "fs-rules-user-token-local-shadow-run-v1",
  "deviations": [],
  "exitCode": 0,
  "firestoreOrigin": "http://127.0.0.1:52879",
  "launchSpecification": {
    "argv": [
      "exec",
      "--firebase-json",
      "<owned-firebase.json>",
      "--project",
      "fireemu-35fe6",
      "--only",
      "auth,firestore",
      "--firestore-port",
      "0",
      "--http-port",
      "0",
      "--hub-port",
      "0",
      "--ui-port",
      "0",
      "--logging-port",
      "0",
      "--log-verbosity",
      "silent",
      "--",
      "<driver-command>"
    ],
    "binary": "fireemu",
    "buildCommand": [
      "cargo",
      "build",
      "--locked",
      "-p",
      "fireemu"
    ],
    "contract": "fs-rules-user-token-shadow-v1",
    "driverEnvironment": [
      "FIRESTORE_EMULATOR_HOST",
      "FIREBASE_AUTH_EMULATOR_HOST"
    ],
    "environmentAllowlist": [
      "PATH",
      "HOME",
      "TMPDIR",
      "LANG",
      "LC_ALL"
    ],
    "forbiddenEnvironment": [
      "GOOGLE_APPLICATION_CREDENTIALS",
      "GOOGLE_CLOUD_PROJECT",
      "GCLOUD_PROJECT",
      "FIREBASE_TOKEN"
    ],
    "notes": "the local Auth emulator mints unsigned tokens, so a local allow proves the Rules decision, never production token verification",
    "portAssignment": "os-assigned",
    "rulesFiles": {
      "A": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /o5-user-token/ne9e7a971f42544938780863fb25d642b/cases/{document} {\n      allow read, write: if false;\n    }\n    match /o5-user-token/ne9e7a971f42544938780863fb25d642b/cases/owned-a {\n      allow get: if request.auth != null && request.auth.uid == resource.data.ownerUid;\n    }\n    match /o5-user-token/ne9e7a971f42544938780863fb25d642b/cases/owned-b {\n      allow get: if request.auth != null && request.auth.uid == resource.data.ownerUid;\n    }\n    match /o5-user-token/ne9e7a971f42544938780863fb25d642b/cases/public-open {\n      allow get: if request.auth == null;\n    }\n    match /o5-user-token/ne9e7a971f42544938780863fb25d642b/cases/claim-gated {\n      allow get: if request.auth != null && request.auth.token.o5role == 'editor';\n    }\n    match /o5-user-token/ne9e7a971f42544938780863fb25d642b/cases/tenant-gated {\n      allow get: if request.auth != null && request.auth.token.firebase.tenant == 'fireemu-00000000000000000001';\n    }\n    match /o5-user-token/ne9e7a971f42544938780863fb25d642b/cases/exists-guarded {\n      allow get: if request.auth != null && exists(/databases/$(database)/documents/o5-user-token/ne9e7a971f42544938780863fb25d642b/cases/exists-guard-present);\n    }\n    match /o5-user-token/ne9e7a971f42544938780863fb25d642b/cases/exists-guarded-missing {\n      allow get: if request.auth != null && exists(/databases/$(database)/documents/o5-user-token/ne9e7a971f42544938780863fb25d642b/cases/exists-guard-absent);\n    }\n    match /o5-user-token/ne9e7a971f42544938780863fb25d642b/cases/get-guarded {\n      allow get: if request.auth != null && get(/databases/$(database)/documents/o5-user-token/ne9e7a971f42544938780863fb25d642b/cases/owned-a).data.ownerUid == request.auth.uid;\n    }\n    match /o5-user-token/ne9e7a971f42544938780863fb25d642b/cases/getafter-target {\n      allow create: if request.auth != null && getAfter(/databases/$(database)/documents/o5-user-token/ne9e7a971f42544938780863fb25d642b/cases/getafter-guard).data.ownerUid == request.auth.uid;\n    }\n    match /o5-user-token/ne9e7a971f42544938780863fb25d642b/cases/getafter-control-target {\n      allow create: if request.auth != null && getAfter(/databases/$(database)/documents/o5-user-token/ne9e7a971f42544938780863fb25d642b/cases/getafter-control-guard).data.ownerUid == request.auth.uid;\n    }\n    match /o5-user-token/ne9e7a971f42544938780863fb25d642b/cases/getafter-guard {\n      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;\n    }\n    match /o5-user-token/ne9e7a971f42544938780863fb25d642b/cases/multiwrite-x {\n      allow get, update: if request.auth != null && request.auth.uid == resource.data.ownerUid;\n    }\n    match /o5-user-token/ne9e7a971f42544938780863fb25d642b/cases/multiwrite-y {\n      allow create: if false;\n    }\n  }\n}",
