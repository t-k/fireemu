  "steps": [
    {
      "id": "runQuery-needing-a-composite-index",
      "status": "documented-divergence",
      "oracle": {
        "body": [
          {
            "document": {
              "createTime": "<timestamp>",
              "fields": {
                "age": {
                  "integerValue": "1"
                },
                "city": {
                  "stringValue": "tokyo"
                },
                "name": {
                  "stringValue": "x"
                }
              },
              "name": "projects/demo-conformance/databases/(default)/documents/conf_index/one",
              "updateTime": "<timestamp>"
            },
            "done": true,
            "readTime": "<timestamp>"
          }
        ],
        "status": 200
      },
      "testd": {
        "body": [
          {
            "document": {
              "createTime": "<timestamp>",
              "fields": {
                "age": {
                  "integerValue": "1"
                },
                "city": {
                  "stringValue": "tokyo"
                },
                "name": {
                  "stringValue": "x"
                }
              },
              "name": "projects/demo-conformance/databases/(default)/documents/conf_index/one",
              "updateTime": "<timestamp>"
            },
            "readTime": "<timestamp>"
          }
        ],
        "status": 200
      },
      "documents": "README.md, \"Gap from the official Firebase Emulator Suite\"",
      "reason": "The official emulator ends a REST runQuery stream with `done: true` on the last response; production omits the field and fireemu follows production."
    },
    {
      "id": "runQuery-with-an-unknown-operator",
      "status": "documented-divergence",
      "oracle": {
        "body": {
          "error": {
            "code": 400,
            "message": "Payload isn't valid for request.",
            "status": "INVALID_ARGUMENT"
          }
        },
        "status": 400
      },
      "testd": {
        "body": [
          {
            "error": {
              "code": 400,
              "details": [
                {
                  "@type": "type.googleapis.com/google.rpc.BadRequest",
                  "fieldViolations": [
                    {
                      "description": "Invalid value at 'structured_query.where.field_filter.op' (type.googleapis.com/google.firestore.v1.StructuredQuery.FieldFilter.Operator), \"NOT_A_REAL_OPERATOR\"",
                      "field": "structured_query.where.field_filter.op"
                    }
                  ]
                }
              ],
              "message": "Invalid value at 'structured_query.where.field_filter.op' (type.googleapis.com/google.firestore.v1.StructuredQuery.FieldFilter.Operator), \"NOT_A_REAL_OPERATOR\"",
              "status": "INVALID_ARGUMENT"
            }
          }
        ],
        "status": 400
      },
      "documents": "conformance/FIRESTORE-PRODUCTION-MATRIX.md; CHANGELOG.md [Unreleased]",
      "reason": "Production refuses a REST runQuery with an unknown field-filter operator with a 400 INVALID_ARGUMENT whose message is `Invalid value at 'structured_query.where.field_filter.op' (type.googleapis.com/google.firestore.v1.StructuredQuery.FieldFilter.Operator), \"<name>\"` (recorded 2026-09-07 and 2026-09-24); the 2026-09-24 recording also shows the BadRequest detail and the error in a one-element array. The official emulator answers `Payload isn't valid for request.`. fireemu follows production in both profiles."
    },
    {
      "id": "get-a-missing-document",
      "status": "documented-divergence",
      "oracle": {
        "body": {
