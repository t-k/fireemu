{
  "schemaVersion": 1,
  "id": "firestore/rest-error-shapes",
  "product": "firestore",
  "title": "The Firestore REST error envelopes for a missing index, bad input and denied access",
  "sdks": [
    "rest"
  ],
  "variant": "baseline",
  "oracle": "official Local Emulator Suite, pinned in ORACLE.md",
  "summary": {
    "parity": 0,
    "documented-divergence": 1,
    "debt": 2,
    "pending": 0
  },
  "steps": [
    {
      "id": "runQuery-needing-a-composite-index",
      "status": "documented-divergence",
      "oracle": {
        "body": [
          {
            "document": {
              "createTime": "<timestamp>",
              "fields": {
                "age": {
                  "integerValue": "1"
                },
                "city": {
                  "stringValue": "tokyo"
                },
                "name": {
                  "stringValue": "x"
                }
              },
              "name": "projects/demo-conformance/databases/(default)/documents/conf_index/one",
              "updateTime": "<timestamp>"
            },
            "done": true,
            "readTime": "<timestamp>"
          }
        ],
        "status": 200
      },
      "testd": {
        "body": [
          {
            "document": {
              "createTime": "<timestamp>",
              "fields": {
                "age": {
                  "integerValue": "1"
                },
                "city": {
                  "stringValue": "tokyo"
                },
                "name": {
                  "stringValue": "x"
                }
              },
              "name": "projects/demo-conformance/databases/(default)/documents/conf_index/one",
              "updateTime": "<timestamp>"
            },
            "readTime": "<timestamp>"
          }
        ],
        "status": 200
      },
      "documents": "README.md, \"Gap from the official Firebase Emulator Suite\"",
      "reason": "The query itself is served on both sides since index merging landed. The official emulator ends the REST runQuery stream with `done: true` on the last response; production omits `done` (probed against the oracle project on 2026-09-08) and fireemu follows production."
    },
    {
      "id": "runQuery-with-an-unknown-operator",
      "status": "debt",
      "oracle": {
        "body": {
          "error": {
            "code": 400,
            "message": "Payload isn't valid for request.",
            "status": "INVALID_ARGUMENT"
          }
        },
        "status": 400
      },
      "testd": {
        "body": {
          "error": {
            "code": 400,
            "message": "unknown field filter operator \"NOT_A_REAL_OPERATOR\"",
            "status": "INVALID_ARGUMENT"
          }
        },
        "status": 400
      }
    },
    {
      "id": "get-a-missing-document",
      "status": "debt",
      "oracle": {
        "body": {
          "error": {
            "code": 404,
            "message": "Document (projects/demo-conformance/databases/(default)/documents/conf_values/definitely-missing) not found.",
            "status": "NOT_FOUND"
          }
        },
        "status": 404
      },
      "testd": {
        "body": {
          "error": {
            "code": 404,
            "message": "Document not found: projects/demo-conformance/databases/(default)/documents/conf_values/definitely-missing",
            "status": "NOT_FOUND"
          }
        },
        "status": 404
      }
    }
  ]
}
