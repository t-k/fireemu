{
  "schemaVersion": 1,
  "parent": "FUNCTIONS-EVENTS",
  "parentStatus": "IMPLEMENTING",
  "inventoryStatus": "FROZEN",
  "oracleTrack": "disposable-sandbox",
  "oracle": {
    "plannedProject": "fireemu-oracle-events",
    "projectStatus": "PLANNED",
    "proposedRegion": "us-central1"
  },
  "closureReview": {
    "decision": "PENDING"
  },
  "scopeDecisions": [
    {
      "id": "E1",
      "decision": "Use the owner-approved dedicated FUNCTIONS-EVENTS sandbox project. The coordinator creates and records its billing, budget, Firebase registration and Auth setup before any production observation.",
      "rationale": "A dedicated project avoids contention with the Storage and HTTP lanes and isolates event-producing resources and deployment side effects.",
      "status": "FROZEN",
      "decidedBy": "owner",
      "decidedOn": "2026-09-25",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-25 sandbox FUNCTIONS-EVENTS project)"
    },
    {
      "id": "E2",
      "decision": "Compare pinned Node.js v1 and v2 SDK handlers for Firestore, Storage and Pub/Sub; use stable v1 Auth create/delete handlers. Defer preview v2 Auth triggers until a separate owner decision.",
      "rationale": "The local contract serves both generations for the first three sources, while the documented v2 Auth create/delete API remains Preview.",
      "status": "FROZEN",
      "decidedBy": "owner",
      "decidedOn": "2026-09-25",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-25 FUNCTIONS-EVENTS E2)"
    },
    {
      "id": "E3",
      "decision": "HTTP/callable, scheduled, task queue, custom Eventarc, Firebase alerts and Blocking Auth are outside this parent. Their separate claims or parents retain responsibility.",
      "rationale": "This parent is explicitly limited to Firestore, Storage, Auth and Pub/Sub trigger delivery and event contents.",
      "status": "FROZEN",
      "decidedBy": "owner",
      "decidedOn": "2026-09-25",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-25 FUNCTIONS-EVENTS E3)"
    },
    {
      "id": "E4",
      "decision": "Write only to a lane-owned collection in the dedicated project's Firestore (default) database. Include a bounded authenticated client write for v2 Firestore auth context; review the user and Rules setup before sending.",
      "rationale": "Path matching, no-op writes, snapshots and auth context require source writes, while a separate collection prevents cross-campaign interference.",
      "status": "FROZEN",
      "decidedBy": "owner",
      "decidedOn": "2026-09-25",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-25 FUNCTIONS-EVENTS E4)"
    },
    {
      "id": "E5",
      "decision": "Use one lane-owned primary bucket and one control bucket with unique object prefixes. Include archived events only after a reviewed versioning enablement, readback and restoration or cleanup plan for the primary bucket.",
      "rationale": "A second bucket makes nonmatching-bucket routing observable, while a same-bucket object must still be delivered regardless of prefix. Archive needs versioning, which changes configuration and cleanup behavior.",
      "status": "FROZEN",
      "decidedBy": "owner",
      "decidedOn": "2026-09-25",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-25 FUNCTIONS-EVENTS E5)"
    },
    {
      "id": "E6",
      "decision": "Create a lane-owned primary Pub/Sub topic and one control topic, publish only bounded fixture messages and verify topic and subscription deletion afterward.",
      "rationale": "A second topic makes negative routing observable; dedicated names bound the side effects.",
      "status": "FROZEN",
      "decidedBy": "owner",
      "decidedOn": "2026-09-25",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-25 FUNCTIONS-EVENTS E6)"
    },
    {
      "id": "E7",
      "decision": "Create and delete only disposable same-project Auth users, one at a time for deletion. Use repeated sign-in as the no-create control. Exclude tenant, blocking, custom-token signing, bulk-delete side effects beyond the explicit negative control, and external IdP sign-in.",
      "rationale": "Stable v1 user create/delete events can be observed without additional signing grants or external IdP state; the proposed email/password fixtures exercise empty providerData only.",
      "status": "FROZEN",
      "decidedBy": "owner",
      "decidedOn": "2026-09-25",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-25 FUNCTIONS-EVENTS E7)"
    },
    {
      "id": "E8",
      "decision": "Keep raw event IDs, timestamps, resource names and payloads privately for both recordings. Compare deterministic fields and field presence; normalize volatile values only after both recordings show their variation.",
      "rationale": "Event IDs and wall-clock timestamps vary between source mutations while routing and payload meaning remain observable.",
      "status": "FROZEN",
      "decidedBy": "owner",
      "decidedOn": "2026-09-25",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-25 FUNCTIONS-EVENTS E8)"
    },
    {
      "id": "E9",
      "decision": "Test a bounded fail-once-then-success handler with a v2 Firestore event. Compare retry eligibility and stable event identity, without requiring an exact attempt count, delay or ordering across independent events. Other sources and v1 retry behavior remain outside this representative retry condition.",
      "rationale": "At-least-once delivery can duplicate or delay events; the corpus must not turn a scheduling observation into a deterministic contract.",
      "status": "FROZEN",
      "decidedBy": "owner",
      "decidedOn": "2026-09-25",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-09-25 FUNCTIONS-EVENTS E9)"
    },
    {
      "id": "E10",
      "decision": "The authId of a 2nd gen Firestore event with auth context is a declared difference in value only, and only for authType unknown. Production prints the writer's own credential identity there (the recorder's user credential: its email); a local session cannot reproduce it, because the local owner bearer has no identity and strict prints owner (a principal that carries an identity prints it). The comparison masks the value of that id for unknown rows and compares its presence; it compares authType exactly; for authType api_key (a write with a Firebase ID token) the id is the user's uid, which a local session reproduces, so its 28-character alphanumeric shape is compared and any other value is a difference. Nothing else is masked by this decision.",
      "rationale": "The operator's email is environment state. Masking the value for unknown and not for api_key keeps a regression that sends the wrong id with an ID token a difference.",
      "reason": "Production's value is the operator's own credential identity; a local owner token carries none.",
      "evidence": "FE v5 (functions-events-formal-20261004T182904Z-a9621bfae74fe9bc) and FE v7 (functions-events-formal-20261005T041505Z-d3fd3faa3e0dc702): handler fsWrittenWithAuthContextV2, 16 frames over two runs, identical in both: an Admin write by the user credential is unknown with the operator's email, a client write with an ID token is api_key with the user's uid. Official emulator (firebase-tools 15.28.2, Firestore emulator jar 1.22.0): unknown and fake-auth-id@gmail.com for every writer, the emulator profile's value.",
      "review": "PENDING (the closure review)",
      "masks": [
        "authId-unknown-present",
        "authId-api_key-uid"
      ],
      "status": "APPROVED",
      "decidedBy": "coordinator (delegated)",
      "decidedOn": "2026-10-05",
      "decisionRef": "docs.local/runs/ownership-lane/coordinator-rulings.md (2026-10-05 15:12Z, admin-write authId and the register) and the review of work/fe-auth-context-strict and work/fe-closure-evidence-r3 (2026-10-05, M-B1)"
    },
    {
      "id": "E11",
      "decision": "The two numbers in the name of the subscription Eventarc makes for a 2nd gen Pub/Sub function (`eventarc-<region>-<function>-<6 digits>-sub-<3 digits>`) are a declared difference in value only: production draws them at random per deployment and fireemu derives its own. The comparison masks the two numbers and compares the rest of the name, so the shape, the region, the function name and the digit counts stay compared; nothing else is masked by this decision.",
      "rationale": "Recorded nondeterminism between deployments: FE v5 834054 and 834, FE v7 293232 and 576, each fixed within a deployment, so the two passes of one run cannot show it varying.",
      "reason": "Per-deployment random numbers.",
      "evidence": "FE v5 (functions-events-formal-20261004T182904Z-a9621bfae74fe9bc) and FE v7 (functions-events-formal-20261005T041505Z-d3fd3faa3e0dc702): every v2 Pub/Sub frame of a run names the same subscription, the two runs differ in the numbers.",
      "review": "PENDING (the closure review)",
      "masks": [
        "pubsub-subscription-numbers"
      ],
      "status": "APPROVED",
      "decidedBy": "coordinator (delegated)",
      "decidedOn": "2026-10-05",
      "decisionRef": "docs.local/runs/ownership-lane/coordinator-rulings.md (2026-10-05, closure comparison ruling 2) and the delta review of work/fe-closure-evidence-r3 (2026-10-06, M-B2)"
    },
    {
      "id": "E12",
      "decision": "The document field maps of a 2nd gen Firestore event (`data`, `before.data` and `after.data`, also under the retry rows' failed and succeeded attempts) are compared without regard to member order; their values are still compared exactly. The member order of every other object, and of 1st gen events, is compared as before.",
      "rationale": "The protobuf map has no defined order, and production's REST answers swap the field order of one document between answers (FE v5 transport responses 0036 and 0037, 0043 to 0045).",
      "reason": "Ledger 840 (coordinator judgment, 2026-10-05): the member order of a Gen2 Firestore document map is not part of the contract.",
      "evidence": "Ledger line 840 of the owner-decisions ledger (FE v5 transport responses 0036, 0037, 0043 to 0045); the retry rows carry the same maps under the attempt that delivered them (FE v5 and FE v7 fsRetryV2, a Gen2 Firestore trigger).",
      "review": "PENDING (the closure review)",
      "masks": [
        "firestore-field-maps-unordered"
      ],
      "status": "APPROVED",
      "decidedBy": "coordinator (delegated)",
      "decidedOn": "2026-10-05",
      "decisionRef": "docs.local/instructions/owner-decisions.md (2026-10-05, FUNCTIONS-EVENTS Firestore Gen2 map member order, ledger line 840)"
    }
  ],
