{
  "schemaVersion": 1,
  "id": "auth/sign-up-and-sign-in-errors",
  "product": "auth",
  "title": "Client sign-up and sign-in successes and every documented credential error",
  "sdks": [
    "firebase/auth",
    "firebase-admin"
  ],
  "variant": "baseline",
  "oracle": "official Local Emulator Suite, pinned in ORACLE.md",
  "summary": {
    "parity": 8,
    "documented-divergence": 0,
    "debt": 0,
    "pending": 0
  },
  "steps": [
    {
      "id": "sign-up",
      "status": "parity",
      "value": {
        "email": "conf-auth-signin-primary@example.com",
        "emailVerified": false,
        "isAnonymous": false,
        "providerId": "password",
        "uidLength": 28
      }
    },
    {
      "id": "sign-up-with-an-email-already-in-use",
      "status": "parity",
      "value": {
        "thrown": true,
        "code": "auth/email-already-in-use",
        "message": "Firebase: Error (auth/email-already-in-use)."
      }
    },
    {
      "id": "sign-up-with-a-weak-password",
      "status": "parity",
      "value": {
        "thrown": true,
        "code": "auth/weak-password",
        "message": "Firebase: Password should be at least 6 characters (auth/weak-password)."
      }
    },
    {
      "id": "sign-up-with-a-malformed-email",
      "status": "parity",
      "value": {
        "thrown": true,
        "code": "auth/invalid-email",
        "message": "Firebase: Error (auth/invalid-email)."
      }
    },
    {
      "id": "sign-in-with-the-wrong-password",
      "status": "parity",
      "value": {
        "thrown": true,
        "code": "auth/wrong-password",
        "message": "Firebase: Error (auth/wrong-password)."
      }
    },
    {
      "id": "sign-in-as-an-unknown-user",
      "status": "parity",
      "value": {
        "thrown": true,
        "code": "auth/user-not-found",
        "message": "Firebase: Error (auth/user-not-found)."
      }
    },
    {
      "id": "sign-in-succeeds-and-mints-an-id-token",
      "status": "parity",
      "value": {
        "aud": "demo-conformance",
        "claimKeys": [
          "aud",
          "auth_time",
          "email",
          "email_verified",
          "exp",
          "firebase",
          "iat",
          "iss",
          "sub",
          "user_id"
        ],
        "firebaseSignInProvider": "password",
        "headerAlg": "none",
        "iss": "https://securetoken.google.com/demo-conformance"
      }
    },
    {
      "id": "sign-out",
      "status": "parity",
      "value": {
        "currentUser": null
      }
    }
  ]
}
