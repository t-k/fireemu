rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /lifecycle-users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /lifecycle-projects/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /lifecycle-mail/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /lifecycle-destinations/{uid}/items/{item} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
