#!/bin/sh
set -eu

if [ "$#" -ne 2 ]; then
  echo "usage: publish-evidence SOURCE_DIR TARGET_DIR" >&2
  exit 2
fi

source_dir=$1
target_dir=$2
if [ -L "$source_dir" ] || [ ! -d "$source_dir" ]; then
  echo "error: evidence source is not a directory: $source_dir" >&2
  exit 2
fi
if [ -L "$target_dir" ] || [ ! -d "$target_dir" ]; then
  echo "error: evidence target is not a directory: $target_dir" >&2
  exit 2
fi

models='AtomicCommitOutbox AtomicExportPublication AuthTotp AwaitIdle CompatibilitySelection EventDelivery FirestoreListenRefresh RegexAuthorization RegexEvaluationCache RegexLinearRepeat RulesetActivation SessionEpoch StorageGeneration TransactionConditionalLock'
for file in cargo-authority.json $models; do
  case "$file" in
    cargo-authority.json) source_file="$source_dir/$file" ;;
    *) source_file="$source_dir/$file.json" ;;
  esac
  if [ -L "$source_file" ] || [ ! -f "$source_file" ]; then
    echo "error: incomplete evidence source: $source_file" >&2
    exit 2
  fi
done

target_parent=$(CDPATH= cd -- "$(dirname -- "$target_dir")" && pwd)
target_name=$(basename -- "$target_dir")
candidate=$(mktemp -d "$target_parent/.${target_name}-candidate.XXXXXX")
backup=$(mktemp -d "$target_parent/.${target_name}-backup.XXXXXX")
rmdir "$backup"

cleanup() {
  if [ -n "${backup:-}" ] && [ -d "$backup" ] && [ ! -e "$target_dir" ]; then
    mv -- "$backup" "$target_dir"
    backup=
  fi
  if [ -n "${candidate:-}" ] && [ -d "$candidate" ]; then
    rm -rf -- "$candidate"
  fi
  if [ -n "${backup:-}" ] && [ -d "$backup" ]; then
    rm -rf -- "$backup"
  fi
}
trap cleanup EXIT HUP INT TERM

cp -- "$source_dir/cargo-authority.json" "$candidate/cargo-authority.json"
for model in $models; do
  cp -- "$source_dir/$model.json" "$candidate/$model.json"
done

mv -- "$target_dir" "$backup"
if ! mv -- "$candidate" "$target_dir"; then
  mv -- "$backup" "$target_dir"
  backup=
  exit 1
fi
candidate=
rm -rf -- "$backup"
backup=
trap - EXIT HUP INT TERM
