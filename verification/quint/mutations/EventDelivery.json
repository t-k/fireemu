{
  "schemaVersion": 1,
  "model": "EventDelivery",
  "mutations": [
    {
      "id": "M-TLA-EVENT-TERMINAL-001",
      "property": "NoTerminalRegression",
      "operator": "allow-cancel-from-terminal-state",
      "from": "action cancelEvent(event) = all {\n    observable.state.get(event).in(NON_TERMINAL),",
      "to": "action cancelEvent(event) = all {\n    observable.state.get(event).in(STATES),"
    },
    {
      "id": "M-TLA-EVENT-LIVENESS-001",
      "property": "EventEventuallyTerminates",
      "operator": "remove-worker-fairness",
      "from": "temporal Fairness = EVENTS.forall(event =>\n    progress(event).weakFair((observable, previousObservable, lastAction, lastTarget))\n  )",
      "to": "temporal Fairness = true"
    },
    {
      "id": "M-TLA-EVENT-LEGAL-001",
      "property": "LegalStateTransitions",
      "operator": "retry-due-from-leased",
      "from": "action retryEvent(event) = all {\n    observable.state.get(event) == RetryWaiting,",
      "to": "action retryEvent(event) = all {\n    observable.state.get(event) == Leased,"
    },
    {
      "id": "M-TLA-EVENT-ATTEMPTS-001",
      "property": "AttemptsChangeOnlyOnStart",
      "operator": "start-without-incrementing-attempts",
      "from": "observable.attempts.set(event, observable.attempts.get(event) + 1),",
      "to": "observable.attempts,"
    },
    {
      "id": "M-TLA-EVENT-STALE-001",
      "property": "StaleDiscardRequiresOlderEpoch",
      "operator": "discard-current-epoch-event",
      "from": "action discardEvent(event) = all {\n    observable.state.get(event).in(NON_TERMINAL),\n    observable.capturedEpoch.get(event) < observable.currentEpoch,",
      "to": "action discardEvent(event) = all {\n    observable.state.get(event).in(NON_TERMINAL),\n    observable.capturedEpoch.get(event) <= observable.currentEpoch,"
    }
  ]
}
