es/$(database)/documents/o5-user-token/nb309642aef1b4e73936b5e8735c91994/cases/getafter-guard).data.ownerUid == request.auth.uid;\n    }\n    match /o5-user-token/nb309642aef1b4e73936b5e8735c91994/cases/getafter-control-target {\n      allow create: if request.auth != null && getAfter(/databases/$(database)/documents/o5-user-token/nb309642aef1b4e73936b5e8735c91994/cases/getafter-control-guard).data.ownerUid == request.auth.uid;\n    }\n    match /o5-user-token/nb309642aef1b4e73936b5e8735c91994/cases/getafter-guard {\n      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;\n    }\n    match /o5-user-token/nb309642aef1b4e73936b5e8735c91994/cases/multiwrite-x {\n      allow get, update: if request.auth != null && request.auth.uid == resource.data.ownerUid;\n    }\n    match /o5-user-token/nb309642aef1b4e73936b5e8735c91994/cases/multiwrite-y {\n      allow create: if false;\n    }\n  }\n}",
