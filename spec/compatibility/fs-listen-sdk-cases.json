  "requiredRulesFragment": "match /o6_listen/{uid}/runs/{runId}/docs/{docId} {\n  allow read, write: if request.auth != null && uid == request.auth.uid;\n}\nmatch /o6_listen_private/{uid} {\n  allow read, write: if request.auth != null && request.auth.uid == uid;\n}\n",
  "runCollection": "o6_listen",
  "schema": "o6-listen-sdk-cases-v1",
  "unobservedPaths": [
    {
      "path": "browser-webchannel",
      "plan": "A separate browser campaign driving the same case catalog through the existing headless Chromium adapter against the same oracle project, with the WebChannel request log captured from the page rather than from Node.",
      "reason": "The Node SDK build selects the gRPC transport; this campaign does not exercise WebChannel framing, long polling, the streamed backchannel or browser tab lifecycle in production. A local browser shadow (listen_browser_adapter.mjs) runs the same catalog through headless Chromium, but that is local evidence only."
    },
    {
      "path": "android-sdk",
      "plan": "An instrumented Android test module that replays the same case catalog and emits the same normalized event rows for comparison.",
      "reason": "No Android runtime, Gradle toolchain or device is available to this lane."
    },
    {
      "path": "apple-sdk",
      "plan": "An XCTest target replaying the same case catalog and emitting the same normalized event rows.",
      "reason": "No iOS or macOS SDK harness exists in this repository."
    },
    {
      "path": "tenant-isolation",
      "plan": "A tenant-scoped throwaway account and a listener case whose principal carries a tenant claim, expecting permission-denied across the tenant boundary, once the oracle project has a second tenant.",
      "reason": "Cases 108/108C observe one principal being refused another principal's private document within one project. Identity Platform tenants are not exercised: both accounts live in the default tenant, so a MATCH says nothing about cross-tenant isolation under Rules."
    },
    {
      "path": "raw-resume-token",
      "plan": "A direct gRPC Listen probe that supplies a chosen resume token and records the TargetChange response, kept as a separate case from SDK-level resume.",
      "reason": "The Node client SDK owns the resume token; it is not exposed to application code, so RESET and stale-token behavior cannot be driven here."
    }
  ]
